---
import '../styles/global.css';
import CookieBanner from '../components/CookieBanner.astro';

interface Props {
  title: string;
  description: string;
  structuredData?: Record<string, unknown> | Array<Record<string, unknown>>;
  ogImage?: string;
  ogImageAlt?: string;
  ogImageWidth?: number;
  ogImageHeight?: number;
  lang?: 'es' | 'en';
  noindex?: boolean;
  hreflangAlternates?: { hreflang: string; href: string }[];
}

const {
  title,
  description,
  structuredData,
  ogImage = '/images/plaza-sotomayor-panorama.jpg',
  ogImageAlt = 'Plaza Sotomayor en Valparaíso, Región de Valparaíso, Chile',
  ogImageWidth = 1280,
  ogImageHeight = 644,
  lang = 'es',
  hreflangAlternates,
  noindex = false
} = Astro.props;

const htmlLang = lang === 'en' ? 'en' : 'es-CL';
const ogLocale = lang === 'en' ? 'en_US' : 'es_CL';

const canonical = Astro.site ? new URL(Astro.url.pathname, Astro.site).toString() : undefined;
const absoluteOgImage = Astro.site ? new URL(ogImage, Astro.site).toString() : undefined;

const defaultAlternates = canonical
  ? [
      { hreflang: 'es-cl', href: canonical },
      { hreflang: 'x-default', href: canonical }
    ]
  : [];
const alternates = hreflangAlternates && hreflangAlternates.length ? hreflangAlternates : defaultAlternates;
---
<!doctype html>
<html lang={htmlLang}>
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={description} />
    <meta name="robots" content={noindex ? "noindex, follow" : "index, follow, max-image-preview:large, max-snippet:-1, max-video-preview:-1"} />
    <meta name="theme-color" content="#0d2a3a" />
    <meta name="color-scheme" content="light" />
    <meta name="author" content="Guía independiente de Plaza Sotomayor" />
    <title>{title}</title>
    {canonical && <link rel="canonical" href={canonical} />}
    {alternates.map((alt) => (
      <link rel="alternate" hreflang={alt.hreflang} href={alt.href} />
    ))}
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="Plaza Sotomayor · Valparaíso, Chile" />
    <meta property="og:locale" content={ogLocale} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    {canonical && <meta property="og:url" content={canonical} />}
    {absoluteOgImage && <meta property="og:image" content={absoluteOgImage} />}
    {absoluteOgImage && <meta property="og:image:width" content={String(ogImageWidth)} />}
    {absoluteOgImage && <meta property="og:image:height" content={String(ogImageHeight)} />}
    {absoluteOgImage && <meta property="og:image:alt" content={ogImageAlt} />}
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    {absoluteOgImage && <meta name="twitter:image" content={absoluteOgImage} />}
    {absoluteOgImage && <meta name="twitter:image:alt" content={ogImageAlt} />}
    <link rel="manifest" href="/manifest.webmanifest" />
    <meta name="mobile-web-app-capable" content="yes" />
    <meta name="apple-mobile-web-app-capable" content="yes" />
    <meta name="apple-mobile-web-app-title" content="Plaza Sotomayor" />
    <meta name="apple-mobile-web-app-status-bar-style" content="black-translucent" />
    <link rel="icon" href="/icons/favicon.svg" type="image/svg+xml" />
    <link rel="icon" href="/icons/favicon-32x32.png" sizes="32x32" type="image/png" />
    <link rel="icon" href="/icons/favicon-16x16.png" sizes="16x16" type="image/png" />
    <link rel="apple-touch-icon" href="/icons/apple-touch-icon.png" sizes="180x180" />
    {structuredData && <script is:inline type="application/ld+json" set:html={JSON.stringify(structuredData)}></script>}
  </head>
  <body id="top">
    <slot />
    <CookieBanner lang={lang} />
    <script is:inline src="/analytics-choice.js"></script>
    <script is:inline>
      if ('serviceWorker' in navigator) {
        window.addEventListener('load', () => {
          navigator.serviceWorker.register('/sw.js').catch(() => {});
        });
      }
    </script>
  </body>
</html>
