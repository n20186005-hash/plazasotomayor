---
import BaseLayout from '../../layouts/BaseLayout.astro';
import SubpageNav from '../../components/SubpageNav.astro';
import SiteFooter from '../../components/SiteFooter.astro';
import { buildAlternates } from '../../i18n';
import { place } from '../../data/place';

const siteUrl = Astro.site ? new URL('/', Astro.site).toString() : undefined;
const alternates = siteUrl ? buildAlternates(siteUrl, { 'es-cl': '/historia/', en: '/en/history/' }) : undefined;
const attractionId = siteUrl ? `${siteUrl}#attraction` : undefined;

const title = 'History of Plaza Sotomayor: Monumento a los Héroes de Iquique & heritage';
const description = 'The history of Plaza Sotomayor in Valparaíso: the origin of its name, the Monumento a los Héroes de Iquique, the 1979 Zona Típica declaration and its inclusion on the UNESCO World Heritage List in 2003.';

const faq = [
  {
    question: 'Who was Rafael Sotomayor and why is the square named after him?',
    answer: 'Rafael Sotomayor Baeza was Chile\'s Minister of War and Navy during the War of the Pacific. The square took his name in the late 19th century as a tribute to his work and to the space\'s link with the country\'s naval memory.'
  },
  {
    question: 'What does the Monumento a los Héroes de Iquique commemorate?',
    answer: 'Inaugurated in 1886, the monument honors the sailors who fell in the naval battles of Iquique and Punta Gruesa. A commemorative crypt lies beneath the ensemble, and the landmark is used for civic and naval ceremonies in Valparaíso.'
  },
  {
    question: 'Why is Plaza Sotomayor part of the UNESCO World Heritage List?',
    answer: 'In 2003 the historic port area of Valparaíso was inscribed on the World Heritage List. The plaza, Barrio Puerto and the buildings that enclose it form part of that protected heritage ensemble.'
  },
  {
    question: 'Why is Valparaíso a UNESCO World Heritage Site?',
    answer: 'In 2003 UNESCO inscribed the historic port area of Valparaíso on the World Heritage List for its outstanding urban value: a hillside port with streets, funiculars and architecture that show how the city adapted to the terrain. Plaza Sotomayor and Barrio Puerto are part of that protected ensemble facing the bay.'
  },
  {
    question: 'When was Plaza Sotomayor declared a Zona Típica (Heritage Zone)?',
    answer: 'Plaza Sotomayor was declared a Zona Típica in 1979, together with the buildings that enclose it, such as the former Intendencia. Its protected area was later extended toward the pier, reinforcing protection of its heritage profile on the port plan.'
  }
];

const attractionSchema = {
  '@context': 'https://schema.org',
  '@type': ['TouristAttraction', 'LandmarksOrHistoricalBuildings'],
  ...(attractionId ? { '@id': attractionId } : {}),
  name: place.fullName,
  url: siteUrl,
  ...(siteUrl ? { image: [new URL(place.heroImage, siteUrl).toString()] } : {})
};

const faqSchema = {
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  mainEntity: faq.map((item) => ({
    '@type': 'Question',
    name: item.question,
    acceptedAnswer: { '@type': 'Answer', text: item.answer }
  }))
};

const breadcrumbSchema = siteUrl
  ? {
      '@context': 'https://schema.org',
      '@type': 'BreadcrumbList',
      itemListElement: [
        { '@type': 'ListItem', position: 1, name: 'Plaza Sotomayor', item: siteUrl },
        { '@type': 'ListItem', position: 2, name: 'History', item: `${siteUrl}en/history/` }
      ]
    }
  : undefined;

const structuredData = [attractionSchema, faqSchema, ...(breadcrumbSchema ? [breadcrumbSchema] : [])];
---

<BaseLayout lang="en" title={title} description={description} structuredData={structuredData} hreflangAlternates={alternates} ogImageAlt="Plaza Sotomayor and the Monumento a los Héroes de Iquique in Valparaíso, Chile">
  <SubpageNav lang="en" altHref="/historia/" />
  <main>
    <section class="relative overflow-hidden bg-[#0d2a3a] text-white">
      <div class="absolute inset-0">
        <img src={place.photos[1].src} alt={place.photos[1].alt} class="h-full w-full object-cover opacity-50" fetchpriority="high" />
        <div class="absolute inset-0 bg-[linear-gradient(90deg,rgba(5,24,34,.92)_0%,rgba(8,31,43,.7)_60%,rgba(8,31,43,.35)_100%)]"></div>
      </div>
      <div class="relative mx-auto max-w-7xl px-5 pb-16 pt-20 lg:px-8 lg:pb-24 lg:pt-28">
        <p class="port-label mb-4 text-[#dfc9a5]">History of the square</p>
        <h1 class="serif-display max-w-4xl text-4xl font-black leading-[.95] sm:text-6xl">History of Plaza Sotomayor</h1>
        <p class="mt-6 max-w-2xl text-lg leading-8 text-white/80">From its origins as a port square to its role as the civic and heritage stage of Valparaíso, the plaza brings together naval memory, monumental architecture and daily life facing the bay.</p>
      </div>
    </section>

    <article class="mx-auto max-w-3xl px-5 py-16 lg:px-8 lg:py-24">
      <section class="scroll-mt-24">
        <h2 class="serif-display text-3xl font-bold text-[#0d2a3a] sm:text-4xl">Origin and name</h2>
        <p class="mt-5 leading-8 text-slate-700">The square sits on the coastal flat of the bay, facing Muelle Prat, and took shape as the main civic space of the port. In the late 19th century it adopted the name of <strong class="text-[#0d2a3a]">Rafael Sotomayor Baeza</strong>, Minister of War and Navy during the War of the Pacific, tying the place to the country's naval memory.</p>
        <p class="mt-4 leading-8 text-slate-700">The end opposite the sea is presided over by the former Intendencia, today the headquarters of the Armada de Chile. The building, designed by Ernesto Urquieta, was completed in 1910 and closes the square with its monumental façade.</p>
      </section>

      <section class="mt-12 scroll-mt-24">
        <h2 class="serif-display text-3xl font-bold text-[#0d2a3a] sm:text-4xl">The Monumento a los Héroes de Iquique</h2>
        <figure class="photo-grain mt-6 overflow-hidden rounded-[1.8rem] bg-[#d9c9ad]">
          <img src={place.photos[1].src} alt={place.photos[1].alt} loading="lazy" class="aspect-[4/3] w-full object-cover" />
          <figcaption class="bg-[#0d2a3a] p-4 text-xs text-white/75">{place.photos[1].caption} — {place.photos[1].author} · {place.photos[1].license}</figcaption>
        </figure>
        <p class="mt-5 leading-8 text-slate-700">In 1886 the <strong class="text-[#0d2a3a]">Monumento a los Héroes de Iquique</strong> was inaugurated at the center of the plaza, erected to honor the sailors who fell in the naval battles of Iquique and Punta Gruesa. Over the years it became the most recognizable urban landmark of Valparaíso and a site of institutional ceremonies. A crypt linked to that memory lies beneath the ensemble.</p>
      </section>

      <section class="mt-12 scroll-mt-24">
        <h2 class="serif-display text-3xl font-bold text-[#0d2a3a] sm:text-4xl">Heritage recognition</h2>
        <p class="mt-5 leading-8 text-slate-700">In <strong class="text-[#0d2a3a]">1979</strong> Plaza Sotomayor was declared a <strong class="text-[#0d2a3a]">Zona Típica (Heritage Zone)</strong> together with the buildings that enclose it, later extending its protected area toward the pier. In <strong class="text-[#0d2a3a]">2003</strong>, the historic port area of Valparaíso entered the UNESCO World Heritage List, and the plaza is part of that ensemble.</p>
        <p class="mt-4 leading-8 text-slate-700">Between the monument, the former Intendencia and Muelle Prat, the plaza sums up the city's identity: maritime memory, monumental architecture, transport and daily life facing the bay.</p>
      </section>

      <section class="mt-12 scroll-mt-24" aria-labelledby="faq-title">
        <h2 id="faq-title" class="serif-display text-3xl font-bold text-[#0d2a3a] sm:text-4xl">Frequently asked questions</h2>
        <div class="mt-8 divide-y divide-[#0d2a3a]/15 border-y border-[#0d2a3a]/15">
          {faq.map((item) => (
            <details class="group py-5">
              <summary class="flex cursor-pointer list-none items-center justify-between gap-5 rounded-lg py-2 text-lg font-extrabold text-[#0d2a3a]">
                {item.question}
                <span class="text-2xl font-light text-[#a94c35] transition-transform group-open:rotate-45" aria-hidden="true">+</span>
              </summary>
              <p class="max-w-3xl pb-3 pr-10 pt-2 leading-7 text-slate-700">{item.answer}</p>
            </details>
          ))}
        </div>
      </section>

      <nav aria-label="Related pages" class="mt-12 flex flex-wrap gap-3 text-sm">
        <a href="/en/" class="rounded-full bg-[#0d2a3a] px-4 py-2.5 font-bold text-white hover:bg-[#123347]">← Main Plaza Sotomayor guide</a>
        <a href="/en/getting-there/" class="rounded-full border border-[#0d2a3a]/15 bg-white px-4 py-2.5 font-bold text-[#0d2a3a] hover:border-[#a94c35]/40">Getting there →</a>
      </nav>
    </article>
  </main>
  <SiteFooter lang="en" />
</BaseLayout>
