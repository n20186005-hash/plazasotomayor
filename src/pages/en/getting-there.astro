---
import BaseLayout from '../../layouts/BaseLayout.astro';
import SubpageNav from '../../components/SubpageNav.astro';
import SiteFooter from '../../components/SiteFooter.astro';
import { buildAlternates } from '../../i18n';
import { place } from '../../data/place';

const siteUrl = Astro.site ? new URL('/', Astro.site).toString() : undefined;
const alternates = siteUrl ? buildAlternates(siteUrl, { 'es-cl': '/como-llegar/', en: '/en/getting-there/' }) : undefined;
const attractionId = siteUrl ? `${siteUrl}#attraction` : undefined;

const title = 'How to get to Plaza Sotomayor, Valparaíso: transport & location';
const description = 'How to get to Plaza Sotomayor in Valparaíso: metro and train (Estación Puerto), buses and trolleybuses, the route from Santiago via Route 68, parking and tips from the bus terminal.';

const faq = [
  {
    question: 'How do I get to Plaza Sotomayor by public transport?',
    answer: 'Estación Puerto station is right next to the plaza and is one of the most direct arrivals. Urban buses and the trolleybus also run through the plan of Valparaíso.'
  },
  {
    question: 'How far is Plaza Sotomayor from the bus terminal?',
    answer: 'From the Valparaíso bus terminal, a taxi or private vehicle usually takes 10 to 15 minutes depending on traffic; you can also combine urban transport or walk through the plan.'
  },
  {
    question: 'Can I get to Plaza Sotomayor from Santiago?',
    answer: 'Yes. Valparaíso is about 120 km away via Route 68; intercity buses, transfer services and private vehicles are the usual options. From the bus station or the center, the port plan is a few minutes away.'
  },
  {
    question: 'Is there a metro or train station near Plaza Sotomayor?',
    answer: 'Yes. Estación Puerto station is right next to the plaza and is part of the Valparaíso–Limache commuter rail system, locally known as Metro Valparaíso or Merval. It is one of the most direct arrivals to move around the plan.'
  },
  {
    question: 'How do I get down from the hills to the plaza level?',
    answer: 'From the Alegre and Concepción hills you can take funiculars such as Ascensor El Peral or Ascensor Concepción and then walk through Barrio Puerto to Plaza Sotomayor. The walk down to the plan level is short and part of the heritage route.'
  }
];

const attractionSchema = {
  '@context': 'https://schema.org',
  '@type': ['TouristAttraction', 'LandmarksOrHistoricalBuildings'],
  ...(attractionId ? { '@id': attractionId } : {}),
  name: place.fullName,
  url: siteUrl,
  ...(siteUrl ? { image: [new URL(place.heroImage, siteUrl).toString()] } : {})
};

const faqSchema = {
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  mainEntity: faq.map((item) => ({
    '@type': 'Question',
    name: item.question,
    acceptedAnswer: { '@type': 'Answer', text: item.answer }
  }))
};

const breadcrumbSchema = siteUrl
  ? {
      '@context': 'https://schema.org',
      '@type': 'BreadcrumbList',
      itemListElement: [
        { '@type': 'ListItem', position: 1, name: 'Plaza Sotomayor', item: siteUrl },
        { '@type': 'ListItem', position: 2, name: 'Getting there', item: `${siteUrl}en/getting-there/` }
      ]
    }
  : undefined;

const structuredData = [attractionSchema, faqSchema, ...(breadcrumbSchema ? [breadcrumbSchema] : [])];
---

<BaseLayout lang="en" title={title} description={description} structuredData={structuredData} hreflangAlternates={alternates} ogImageAlt="Plaza Sotomayor and Muelle Prat in Valparaíso, Chile">
  <SubpageNav lang="en" altHref="/como-llegar/" />
  <main>
    <section class="relative overflow-hidden bg-[#0d2a3a] text-white">
      <div class="absolute inset-0">
        <img src={place.photos[3].src} alt={place.photos[3].alt} class="h-full w-full object-cover opacity-50" fetchpriority="high" />
        <div class="absolute inset-0 bg-[linear-gradient(90deg,rgba(5,24,34,.92)_0%,rgba(8,31,43,.7)_60%,rgba(8,31,43,.35)_100%)]"></div>
      </div>
      <div class="relative mx-auto max-w-7xl px-5 pb-16 pt-20 lg:px-8 lg:pb-24 lg:pt-28">
        <p class="port-label mb-4 text-[#dfc9a5]">Location & access</p>
        <h1 class="serif-display max-w-4xl text-4xl font-black leading-[.95] sm:text-6xl">How to get to Plaza Sotomayor</h1>
        <p class="mt-6 max-w-2xl text-lg leading-8 text-white/80">The plaza is on the plan of Valparaíso, facing Muelle Prat. Here are the options to arrive by public transport, by car or from Santiago.</p>
      </div>
    </section>

    <article class="mx-auto max-w-3xl px-5 py-16 lg:px-8 lg:py-24">
      <section class="scroll-mt-24">
        <h2 class="serif-display text-3xl font-bold text-[#0d2a3a] sm:text-4xl">By public transport</h2>
        <p class="mt-5 leading-8 text-slate-700"><strong class="text-[#0d2a3a]">Estación Puerto</strong> station is right next to the plaza and is one of the most direct arrivals to move around the plan of Valparaíso. Several urban buses and the <strong class="text-[#0d2a3a]">trolleybus</strong> run through the Barrio Puerto axis; the trolleybus is also part of the city's historical transport landscape.</p>
      </section>

      <section class="mt-12 scroll-mt-24">
        <h2 class="serif-display text-3xl font-bold text-[#0d2a3a] sm:text-4xl">From Santiago</h2>
        <p class="mt-5 leading-8 text-slate-700">Valparaíso is about <strong class="text-[#0d2a3a]">120 km</strong> away via <strong class="text-[#0d2a3a]">Route 68</strong>. Intercity buses, transfer services and private vehicles are the usual options. From the bus station or the center, the port plan is a few minutes away.</p>
        <p class="mt-4 leading-8 text-slate-700">Chile Travel estimates roughly 10–15 minutes by taxi or private vehicle from the Valparaíso bus terminal to the plaza, depending on traffic.</p>
      </section>

      <section class="mt-12 scroll-mt-24">
        <h2 class="serif-display text-3xl font-bold text-[#0d2a3a] sm:text-4xl">By car and parking</h2>
        <p class="mt-5 leading-8 text-slate-700">There are private parking lots around Errázuriz and Estación Puerto, plus offer in the central sector. Rates, access and spaces may vary; on weekends, events or ceremonies, public transport is worth considering.</p>
        <p class="mt-4 leading-8 text-slate-700">If your plan includes hills, funiculars and viewpoints, leaving the car and continuing on foot usually simplifies the route. Valparaíso has steep slopes: comfortable footwear makes a real difference.</p>
      </section>

      <section class="mt-12 scroll-mt-24">
        <h2 class="serif-display text-3xl font-bold text-[#0d2a3a] sm:text-4xl">Map and location</h2>
        <p class="mt-5 leading-8 text-slate-700"><strong class="text-[#0d2a3a]">{place.address}</strong> · Plus Code: {place.plusCode}.</p>
        <div class="mt-6 overflow-hidden rounded-[1.8rem] border-8 border-[#f7f4ed] bg-[#f7f4ed] shadow-xl shadow-[#0d2a3a]/10">
          <iframe src={place.embedUrl} title="Map of Plaza Sotomayor in Valparaíso" class="h-[420px] w-full border-0 lg:h-[480px]" allowfullscreen loading="lazy" referrerpolicy="strict-origin-when-cross-origin"></iframe>
        </div>
        <p class="mt-4 text-sm leading-6 text-slate-600">For directions, open{' '}
          <a href={place.mapsUrl} target="_blank" rel="noopener noreferrer" class="font-bold text-[#0d2a3a] underline decoration-[#a94c35] decoration-2 underline-offset-4">Plaza Sotomayor on Google Maps ↗</a>.
        </p>
      </section>

      <section class="mt-12 scroll-mt-24" aria-labelledby="faq-title">
        <h2 id="faq-title" class="serif-display text-3xl font-bold text-[#0d2a3a] sm:text-4xl">Frequently asked questions</h2>
        <div class="mt-8 divide-y divide-[#0d2a3a]/15 border-y border-[#0d2a3a]/15">
          {faq.map((item) => (
            <details class="group py-5">
              <summary class="flex cursor-pointer list-none items-center justify-between gap-5 rounded-lg py-2 text-lg font-extrabold text-[#0d2a3a]">
                {item.question}
                <span class="text-2xl font-light text-[#a94c35] transition-transform group-open:rotate-45" aria-hidden="true">+</span>
              </summary>
              <p class="max-w-3xl pb-3 pr-10 pt-2 leading-7 text-slate-700">{item.answer}</p>
            </details>
          ))}
        </div>
      </section>

      <nav aria-label="Related pages" class="mt-12 flex flex-wrap gap-3 text-sm">
        <a href="/en/" class="rounded-full bg-[#0d2a3a] px-4 py-2.5 font-bold text-white hover:bg-[#123347]">← Main Plaza Sotomayor guide</a>
        <a href="/en/history/" class="rounded-full border border-[#0d2a3a]/15 bg-white px-4 py-2.5 font-bold text-[#0d2a3a] hover:border-[#a94c35]/40">History →</a>
      </nav>
    </article>
  </main>
  <SiteFooter lang="en" />
</BaseLayout>
