---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Breadcrumbs from '../../components/Breadcrumbs.astro';
import SiteFooter from '../../components/SiteFooter.astro';
import SourcesSection from '../../components/SourcesSection.astro';
import { buildAlternates } from '../../i18n';
import { breadcrumb, place } from '../../data/place';
import { faqEn, foodEn, nearbyEn } from '../../data/place.en';

const title = 'Plaza Sotomayor, Valparaíso: visitor guide, history & how to get there';
const description = 'Guide to Plaza Sotomayor in Valparaíso, Chile: its history, the Monumento a los Héroes de Iquique, how to get there, map and location, what to do nearby (Muelle Prat, Ascensor El Peral) and practical tips for your visit.';
const siteUrl = Astro.site ? new URL('/', Astro.site).toString() : undefined;
const heroImageUrl = Astro.site ? new URL(place.heroImage, Astro.site).toString() : undefined;
const attractionId = siteUrl ? `${siteUrl}#attraction` : undefined;
const webSiteId = siteUrl ? `${siteUrl}#website` : undefined;
const alternates = siteUrl ? buildAlternates(siteUrl, { 'es-cl': '/', en: '/en/' }) : undefined;

const attractionSchema = {
  '@context': 'https://schema.org',
  '@type': ['TouristAttraction', 'LandmarksOrHistoricalBuildings'],
  ...(attractionId ? { '@id': attractionId } : {}),
  name: place.fullName,
  alternateName: place.alternateNames,
  description,
  ...(siteUrl ? { url: siteUrl } : {}),
  ...(heroImageUrl ? { image: [heroImageUrl] } : {}),
  address: {
    '@type': 'PostalAddress',
    streetAddress: 'Plaza Sotomayor',
    addressLocality: place.city,
    addressRegion: place.region,
    postalCode: place.postalCode,
    addressCountry: place.countryCode
  },
  geo: {
    '@type': 'GeoCoordinates',
    latitude: place.latitude,
    longitude: place.longitude
  },
  hasMap: place.mapsUrl,
  containedInPlace: {
    '@type': 'City',
    name: place.city,
    containedInPlace: {
      '@type': 'AdministrativeArea',
      name: place.region,
      containedInPlace: {
        '@type': 'Country',
        name: place.country
      }
    }
  },
  touristType: ['Cultural tourism', 'Heritage tourism', 'City tourism'],
  openingHoursSpecification: [
    {
      '@type': 'OpeningHoursSpecification',
      dayOfWeek: ['Monday', 'Tuesday', 'Wednesday', 'Thursday', 'Friday', 'Saturday', 'Sunday'],
      opens: '00:00',
      closes: '23:59'
    }
  ],
  isAccessibleForFree: true,
  publicAccess: true,
  aggregateRating: {
    '@type': 'AggregateRating',
    ratingValue: place.rating,
    reviewCount: place.reviewCount,
    bestRating: 5,
    worstRating: 1
  },
  sameAs: [place.mapsUrl, place.govtTourismUrl, place.wikipediaUrl, place.municipalityUrl]
};

const webSiteSchema = {
  '@context': 'https://schema.org',
  '@type': 'WebSite',
  ...(webSiteId ? { '@id': webSiteId } : {}),
  ...(siteUrl ? { url: siteUrl } : {}),
  name: 'Plaza Sotomayor — Valparaíso, Chile',
  inLanguage: 'en',
  ...(attractionId ? { about: { '@id': attractionId } } : {})
};

const webPageSchema = {
  '@context': 'https://schema.org',
  '@type': 'WebPage',
  ...(siteUrl ? { '@id': `${siteUrl}#webpage` } : {}),
  ...(siteUrl ? { url: siteUrl } : {}),
  name: title,
  description,
  inLanguage: 'en',
  ...(attractionId ? { about: { '@id': attractionId } } : {}),
  ...(webSiteId ? { isPartOf: { '@id': webSiteId } } : {})
};

const breadcrumbSchema = siteUrl
  ? {
      '@context': 'https://schema.org',
      '@type': 'BreadcrumbList',
      itemListElement: breadcrumb.map((item, index) => ({
        '@type': 'ListItem',
        position: index + 1,
        name: item.name,
        item: item.href === '#inicio' ? siteUrl : `${siteUrl}${item.href}`
      }))
    }
  : undefined;

const faqSchema = {
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  mainEntity: faqEn.map((item) => ({
    '@type': 'Question',
    name: item.question,
    acceptedAnswer: {
      '@type': 'Answer',
      text: item.answer
    }
  }))
};

const structuredData = [
  attractionSchema,
  webSiteSchema,
  webPageSchema,
  ...(breadcrumbSchema ? [breadcrumbSchema] : []),
  faqSchema
];
---
<BaseLayout
  lang="en"
  title={title}
  description={description}
  structuredData={structuredData}
  hreflangAlternates={alternates}
  ogImageAlt="Plaza Sotomayor and the Monumento a los Héroes de Iquique in Valparaíso, Chile"
>
  <header class="absolute inset-x-0 top-0 z-40">
    <div class="mx-auto flex max-w-7xl items-center justify-between px-5 py-5 lg:px-8">
      <a href="#inicio" class="focus-ring inline-flex items-center gap-3 rounded-full bg-[#f4f0e8]/95 px-4 py-2.5 shadow-lg shadow-black/10 backdrop-blur" aria-label="Plaza Sotomayor, back to top">
        <img src="/images/logo.svg" alt="" width="36" height="36" />
        <span class="hidden sm:block">
          <strong class="block text-sm leading-none text-[#0d2a3a]">Plaza Sotomayor</strong>
          <span class="port-label mt-1 block text-[9px] text-[#1f6d79]">Valparaíso · Chile</span>
        </span>
      </a>
      <nav aria-label="Main navigation" class="flex items-center gap-2">
        <a href="#visita" class="hidden rounded-full bg-white/90 px-4 py-2.5 text-sm font-bold text-[#0d2a3a] backdrop-blur hover:bg-white sm:inline-flex">Plan</a>
        <a href="#mapa" class="rounded-full bg-[#a94c35] px-4 py-2.5 text-sm font-bold text-white shadow-lg hover:bg-[#923f2d]">View map</a>
        <a href="/" class="hidden rounded-full border border-white/30 bg-white/10 px-4 py-2.5 text-sm font-bold text-white backdrop-blur hover:bg-white/20 sm:inline-flex">Español</a>
      </nav>
    </div>
  </header>

  <main>
    <section id="inicio" class="relative min-h-[92svh] overflow-hidden bg-[#0d2a3a] text-white">
      <div class="absolute inset-0">
        <img src={place.photos[0].src} alt={place.photos[0].alt} class="h-full w-full object-cover opacity-55" fetchpriority="high" />
        <div class="absolute inset-0 bg-[linear-gradient(90deg,rgba(5,24,34,.92)_0%,rgba(8,31,43,.64)_47%,rgba(8,31,43,.18)_100%)]"></div>
        <div class="absolute inset-x-0 bottom-0 h-48 bg-gradient-to-t from-[#0d2a3a] to-transparent"></div>
      </div>
      <div class="relative mx-auto flex min-h-[92svh] max-w-7xl items-end px-5 pb-16 pt-36 lg:px-8 lg:pb-24">
        <div class="max-w-4xl">
          <div class="mb-7 flex flex-wrap items-center gap-3 text-sm">
            <span class="port-label rounded-full border border-white/30 bg-white/10 px-3 py-2 backdrop-blur">Civic center · Barrio Puerto</span>
            <span class="rounded-full bg-[#f4f0e8] px-3 py-2 font-extrabold text-[#0d2a3a]">★ {place.rating} · {place.reviewCount.toLocaleString('en-US')} reviews</span>
          </div>
          <p class="port-label mb-4 text-[#dfc9a5]">Between the monument and the sea</p>
          <h1 class="serif-display max-w-4xl text-5xl font-black tracking-[-.04em] sm:text-7xl lg:text-[6.6rem] lg:leading-[.88]">
            Plaza Sotomayor
            <span class="mt-3 block text-2xl font-semibold tracking-normal text-[#dfc9a5] sm:text-3xl">Valparaíso, Chile</span>
          </h1>
          <p class="mt-7 max-w-2xl text-lg leading-8 text-white/82 sm:text-xl">Welcome to <strong class="font-extrabold text-white">Plaza Sotomayor</strong>, internationally recognized as the central square of <strong class="font-extrabold text-white">Valparaíso</strong>, Región de Valparaíso, Chile. It is the main meeting point for those who visit the city and its port.</p>
          <p class="mt-4 max-w-2xl text-base leading-8 text-white/70 sm:text-lg">The grand civic hall of Valparaíso: an open square facing the port, marked by the Monumento a los Héroes de Iquique and the blue façade of the former Intendencia.</p>
          <div class="mt-9 flex flex-wrap gap-3">
            <a href="#visita" class="rounded-full bg-[#f4f0e8] px-6 py-3.5 font-extrabold text-[#0d2a3a] transition hover:-translate-y-0.5">Plan your visit</a>
            <a href={place.mapsUrl} target="_blank" rel="noopener noreferrer" class="rounded-full border border-white/35 bg-white/10 px-6 py-3.5 font-extrabold text-white backdrop-blur transition hover:bg-white/20">Open in Google Maps ↗</a>
          </div>
        </div>
      </div>
      <div class="absolute bottom-7 right-5 hidden text-right text-xs text-white/70 lg:block lg:right-8">
        <span class="port-label">Coordinates</span><br />{place.latitude}, {place.longitude}
      </div>
    </section>

    <section id="acerca" class="scroll-mt-24 bg-[#0d2a3a] pb-20 text-white lg:pb-28">
      <div class="mx-auto grid max-w-7xl gap-12 px-5 pt-16 lg:grid-cols-[.85fr_1.15fr] lg:px-8 lg:pt-20">
        <div>
          <Breadcrumbs lang="en" />
          <p class="port-label mb-4 mt-8 text-[#dfc9a5]">01 · About the square</p>
          <h2 class="serif-display text-4xl font-bold leading-tight sm:text-5xl">About <span class="text-[#dfc9a5]">Plaza Sotomayor</span></h2>
          <p class="mt-5 text-lg leading-8 text-white/70">A civic axis built with port memory.</p>
        </div>
        <div class="grid gap-6 text-base leading-8 text-white/76 sm:grid-cols-2">
          <p>Plaza Sotomayor sits on the coastal flat of the bay, facing Muelle Prat. It was declared a <strong class="text-white">Zona Típica (Heritage Zone) in 1979</strong>, and its protected area was later extended toward the pier.</p>
          <p>At its center stands the <strong class="text-white">Monumento a los Héroes de Iquique</strong>, erected in 1886. Beneath the ensemble is a crypt linked to the sailors of the battles of Iquique and Punta Gruesa.</p>
          <p>The end opposite the sea is presided over by the former Intendencia, today a naval headquarters. The building was designed by Ernesto Urquieta and completed for the centennial of the Republic.</p>
          <p>The plaza–station–pier sequence shows, in a few meters, the identity of Valparaíso: port administration, transport, daily life, monumental architecture and the seashore.</p>
        </div>
      </div>

      <div id="historia" class="mx-auto mt-16 max-w-7xl scroll-mt-24 px-5 lg:px-8 lg:mt-20">
        <div class="grid gap-8 lg:grid-cols-[.85fr_1.15fr]">
          <div>
            <p class="port-label mb-4 text-[#dfc9a5]">History and meaning</p>
            <h2 class="serif-display text-4xl font-bold leading-tight sm:text-5xl">History and meaning of <span class="text-[#dfc9a5]">Plaza Sotomayor</span></h2>
          </div>
          <div class="grid gap-6 text-base leading-8 text-white/76 sm:grid-cols-2">
            <p>The square's name honors <strong class="text-white">Rafael Sotomayor Baeza</strong>, Minister of War and Navy during the War of the Pacific. From the late 19th century the space became tied to the country's naval memory and to the civic life of the port.</p>
            <p>In <strong class="text-white">1886</strong> the <strong class="text-white">Monumento a los Héroes de Iquique</strong> was inaugurated at its center, which over the years became the most recognizable urban landmark of Valparaíso and a site of institutional ceremonies.</p>
            <p>The historic area of Valparaíso was inscribed in <strong class="text-white">2003</strong> on the UNESCO World Heritage List. The plaza, Barrio Puerto and the buildings that enclose it are part of that protected port ensemble.</p>
            <p>Between the monument, the former Intendencia and Muelle Prat, the plaza sums up the city's identity: maritime memory, monumental architecture, transport and daily life facing the bay.</p>
          </div>
        </div>
        <ol class="mt-12 grid gap-4 sm:grid-cols-2 lg:grid-cols-4">
          <li class="rounded-[1.6rem] border border-white/12 bg-white/[.06] p-6">
            <span class="font-mono text-sm text-[#dfc9a5]">1886</span>
            <p class="mt-4 text-sm leading-6 text-white/72">Inauguration of the Monumento a los Héroes de Iquique, the central work of the plaza and of Chilean naval memory.</p>
          </li>
          <li class="rounded-[1.6rem] border border-white/12 bg-white/[.06] p-6">
            <span class="font-mono text-sm text-[#dfc9a5]">1910</span>
            <p class="mt-4 text-sm leading-6 text-white/72">Completion of the former Intendencia building, designed by Ernesto Urquieta, as the monumental backdrop facing the sea.</p>
          </li>
          <li class="rounded-[1.6rem] border border-white/12 bg-white/[.06] p-6">
            <span class="font-mono text-sm text-[#dfc9a5]">1979</span>
            <p class="mt-4 text-sm leading-6 text-white/72">Plaza Sotomayor is declared a Zona Típica together with the buildings that enclose it, later extending its protected area toward the pier.</p>
          </li>
          <li class="rounded-[1.6rem] border border-white/12 bg-white/[.06] p-6">
            <span class="font-mono text-sm text-[#dfc9a5]">2003</span>
            <p class="mt-4 text-sm leading-6 text-white/72">The historic port area of Valparaíso enters the UNESCO World Heritage List.</p>
          </li>
        </ol>
      </div>
    </section>

    <section class="mx-auto max-w-7xl px-5 py-20 lg:px-8 lg:py-28" aria-labelledby="galeria-title">
      <div class="mb-10 flex items-end justify-between gap-6">
        <div>
          <p class="port-label mb-3 text-[#a94c35]">02 · Look closely</p>
          <h2 id="galeria-title" class="serif-display text-4xl font-bold text-[#0d2a3a] sm:text-5xl">Port views</h2>
        </div>
        <p class="hidden max-w-sm text-sm leading-6 text-slate-600 md:block">Real photographs with visible attribution. Surrounding schedules and conditions may change.</p>
      </div>
      <div class="grid gap-5 md:grid-cols-12">
        <figure class="photo-grain overflow-hidden rounded-[2rem] bg-[#d9c9ad] md:col-span-7">
          <img src={place.photos[1].src} alt={place.photos[1].alt} loading="lazy" class="aspect-[4/3] h-full max-h-[620px] w-full object-cover" />
          <figcaption class="absolute inset-x-0 bottom-0 z-10 bg-gradient-to-t from-black/75 to-transparent p-6 pt-16 text-sm text-white">
            <strong class="block text-base">{place.photos[1].caption}</strong>
            <a href={place.photos[1].source} target="_blank" rel="noopener noreferrer" class="mt-1 inline-block text-white/75 underline decoration-white/30 underline-offset-4">{place.photos[1].author} · {place.photos[1].license}</a>
          </figcaption>
        </figure>
        <div class="grid gap-5 md:col-span-5">
          {place.photos.slice(2).map((photo) => (
            <figure class="photo-grain relative overflow-hidden rounded-[2rem] bg-[#d9c9ad]">
              <img src={photo.src} alt={photo.alt} loading="lazy" class="aspect-[16/10] w-full object-cover" />
              <figcaption class="absolute inset-x-0 bottom-0 z-10 bg-gradient-to-t from-black/80 to-transparent p-5 pt-12 text-xs text-white">
                <strong class="block text-sm">{photo.caption}</strong>
                <a href={photo.source} target="_blank" rel="noopener noreferrer" class="mt-1 inline-block text-white/75 underline decoration-white/30 underline-offset-4">{photo.author} · {photo.license}</a>
              </figcaption>
            </figure>
          ))}
        </div>
      </div>
    </section>

    <section id="visita" class="bg-[#e5dbc8] py-20 lg:py-28">
      <div class="mx-auto max-w-7xl px-5 lg:px-8">
        <div class="grid gap-10 lg:grid-cols-[.75fr_1.25fr]">
          <div>
            <p class="port-label mb-3 text-[#a94c35]">03 · Plan</p>
            <h2 class="serif-display text-4xl font-bold text-[#0d2a3a] sm:text-5xl">The practical,<br />no detours.</h2>
            <p class="mt-6 max-w-md leading-7 text-slate-700">The plaza works best as a starting point. Arrive, understand the monumental axis and then head to the pier or up the hills.</p>
          </div>
          <div class="grid gap-4 sm:grid-cols-2">
            <article class="rounded-[1.7rem] bg-[#f7f4ed] p-6 shadow-sm">
              <span class="port-label text-[#1f6d79]">Entry / cost</span>
              <h3 class="mt-3 text-xl font-extrabold text-[#0d2a3a]">Plaza: free</h3>
              <p class="mt-3 text-sm leading-6 text-slate-700">{place.admission}</p>
            </article>
            <article class="rounded-[1.7rem] bg-[#0d2a3a] p-6 text-white shadow-sm">
              <span class="port-label text-[#dfc9a5]">Hours</span>
              <h3 class="mt-3 text-xl font-extrabold">Continuous access</h3>
              <p class="mt-3 text-sm leading-6 text-white/75">It is an open public space. Museums, shops and bay tours keep their own hours.</p>
            </article>
            <article class="rounded-[1.7rem] bg-[#f7f4ed] p-6 shadow-sm">
              <span class="port-label text-[#1f6d79]">Best time</span>
              <h3 class="mt-3 text-xl font-extrabold text-[#0d2a3a]">Morning or afternoon</h3>
              <p class="mt-3 text-sm leading-6 text-slate-700">{place.bestTime}</p>
            </article>
            <article class="rounded-[1.7rem] bg-[#a94c35] p-6 text-white shadow-sm">
              <span class="port-label text-white/70">Suggested time</span>
              <h3 class="mt-3 text-xl font-extrabold">45–90 min</h3>
              <p class="mt-3 text-sm leading-6 text-white/80">{place.recommendedStay}</p>
            </article>
          </div>
        </div>
      </div>
    </section>

    <section class="mx-auto max-w-7xl px-5 py-20 lg:px-8 lg:py-28">
      <div class="grid gap-14 lg:grid-cols-2">
        <div>
          <p class="port-label mb-3 text-[#a94c35]">04 · Location & access</p>
          <h2 class="serif-display text-4xl font-bold text-[#0d2a3a] sm:text-5xl">Location and how to visit Plaza Sotomayor in Valparaíso</h2>
          <p class="mt-5 max-w-md text-lg leading-8 text-slate-700">Getting to the heart of the plan.</p>
          <div class="route-line mt-8 space-y-7">
            <div class="relative pl-8">
              <span class="absolute left-0 top-1.5 h-3 w-3 rounded-full bg-[#a94c35]"></span>
              <h3 class="font-extrabold text-[#0d2a3a]">Metro / train</h3>
              <p class="mt-1 leading-7 text-slate-700">Estación Puerto station is right next to Plaza Sotomayor and is one of the most direct arrivals to move around the plan of Valparaíso.</p>
            </div>
            <div class="relative pl-8">
              <span class="absolute left-0 top-1.5 h-3 w-3 rounded-full bg-[#a94c35]"></span>
              <h3 class="font-extrabold text-[#0d2a3a]">Urban bus and trolleybus</h3>
              <p class="mt-1 leading-7 text-slate-700">Different services run through the plan and the Barrio Puerto axis. The trolleybus is part of Valparaíso's historical transport landscape.</p>
            </div>
            <div class="relative pl-8">
              <span class="absolute left-0 top-1.5 h-3 w-3 rounded-full bg-[#a94c35]"></span>
              <h3 class="font-extrabold text-[#0d2a3a]">From the bus terminal</h3>
              <p class="mt-1 leading-7 text-slate-700">Chile Travel estimates roughly 10–15 minutes by taxi or private vehicle. You can also combine urban transport or walk through the plan.</p>
            </div>
            <div class="relative pl-8">
              <span class="absolute left-0 top-1.5 h-3 w-3 rounded-full bg-[#a94c35]"></span>
              <h3 class="font-extrabold text-[#0d2a3a]">From Santiago</h3>
              <p class="mt-1 leading-7 text-slate-700">Valparaíso is about 120 km away via Route 68; intercity buses, transfers and private vehicles are the usual options.</p>
            </div>
          </div>
        </div>
        <div class="rounded-[2rem] border border-[#0d2a3a]/10 bg-white p-7 lg:p-9">
          <div class="flex items-start justify-between gap-6">
            <div>
              <p class="port-label text-[#1f6d79]">Parking</p>
              <h2 class="mt-3 text-3xl font-black text-[#0d2a3a]">Driving there</h2>
            </div>
            <span class="rounded-full bg-[#e5dbc8] px-3 py-1.5 text-xs font-bold text-[#0d2a3a]">Puerto sector</span>
          </div>
          <p class="mt-6 leading-7 text-slate-700">There are private parking lots around Errázuriz and Estación Puerto, plus offer in the central sector. Rates, access and spaces may vary; on weekends, events or ceremonies, public transport is worth considering.</p>
          <div class="mt-8 border-t border-slate-200 pt-6">
            <h3 class="font-extrabold text-[#0d2a3a]">Port tip</h3>
            <p class="mt-2 text-sm leading-6 text-slate-600">If your plan includes hills, funiculars and viewpoints, leaving the car and continuing on foot usually simplifies the route. Valparaíso has steep slopes: comfortable footwear makes a real difference.</p>
          </div>
        </div>
      </div>
    </section>

    <section class="bg-[#0d2a3a] py-20 text-white lg:py-28">
      <div class="mx-auto max-w-7xl px-5 lg:px-8">
        <div class="grid gap-12 lg:grid-cols-[.7fr_1.3fr]">
          <div>
            <p class="port-label mb-3 text-[#dfc9a5]">05 · On foot</p>
            <h2 class="serif-display text-4xl font-bold sm:text-5xl">Monuments and attractions near Plaza Sotomayor</h2>
            <p class="mt-5 max-w-md leading-7 text-white/70">When visiting Plaza Sotomayor, travelers can easily explore historic landmarks and points of interest nearby, including Muelle Prat and Ascensor El Peral.</p>
            <p class="mt-3 max-w-md leading-7 text-white/60">You don't need to "finish" the plaza: use it as a hub between the plan, the port and the historic hills.</p>
          </div>
          <div class="grid gap-4 sm:grid-cols-2">
            {nearbyEn.map((item, index) => (
              <article class="rounded-[1.6rem] border border-white/12 bg-white/[.06] p-6">
                <div class="flex items-center justify-between gap-4">
                  <span class="font-mono text-sm text-[#dfc9a5]">0{index + 1}</span>
                  <span class="port-label text-[10px] text-white/45">{item.type}</span>
                </div>
                <h3 class="mt-8 text-2xl font-extrabold">{item.name}</h3>
                <p class="mt-3 text-sm leading-6 text-white/68">{item.detail}</p>
              </article>
            ))}
          </div>
        </div>
      </div>
    </section>

    <section class="mx-auto max-w-7xl px-5 py-20 lg:px-8 lg:py-28">
      <div class="mb-10 grid gap-5 md:grid-cols-2 md:items-end">
        <div>
          <p class="port-label mb-3 text-[#a94c35]">06 · A bite nearby</p>
          <h2 class="serif-display text-4xl font-bold text-[#0d2a3a] sm:text-5xl">A pause in Barrio Puerto.</h2>
        </div>
        <p class="max-w-lg text-sm leading-6 text-slate-600 md:justify-self-end">Orientative selection of spots in the immediate surroundings. Offer, menu and hours may change: confirm before going if you seek a specific service.</p>
      </div>
      <div class="grid gap-4 md:grid-cols-3">
        {foodEn.map((item) => (
          <article class="rounded-[1.7rem] border border-[#0d2a3a]/10 bg-white p-6 shadow-sm">
            <p class="port-label text-[10px] text-[#1f6d79]">{item.kind}</p>
            <h3 class="mt-4 text-2xl font-extrabold text-[#0d2a3a]">{item.name}</h3>
            <p class="mt-1 text-sm font-semibold text-[#a94c35]">{item.address}</p>
            <p class="mt-5 text-sm leading-6 text-slate-600">{item.note}</p>
          </article>
        ))}
      </div>
    </section>

    <section id="mapa" class="scroll-mt-24 bg-[#d9c9ad] py-20 lg:py-28">
      <div class="mx-auto max-w-7xl px-5 lg:px-8">
        <div class="mb-8 flex flex-wrap items-end justify-between gap-5">
          <div>
            <p class="port-label mb-3 text-[#a94c35]">07 · Location & map</p>
            <h2 class="serif-display text-4xl font-bold text-[#0d2a3a] sm:text-5xl">Map of Plaza Sotomayor: facing the bay.</h2>
          </div>
          <div class="text-sm leading-6 text-slate-700 md:text-right">
            <strong>{place.address}</strong><br />Plus Code: {place.plusCode}
          </div>
        </div>
        <div class="overflow-hidden rounded-[2rem] border-8 border-[#f7f4ed] bg-[#f7f4ed] shadow-xl shadow-[#0d2a3a]/10">
          <iframe src={place.embedUrl} title="Map of Plaza Sotomayor in Valparaíso" class="h-[480px] w-full border-0 lg:h-[570px]" allowfullscreen loading="lazy" referrerpolicy="strict-origin-when-cross-origin"></iframe>
        </div>
        <div class="mt-5 flex flex-wrap items-center justify-between gap-4">
          <p class="max-w-xl text-sm leading-6 text-slate-700">
            For official information and regional updates, visit{' '}
            <a href={place.govtTourismUrl} target="_blank" rel="noopener noreferrer" class="font-bold text-[#0d2a3a] underline decoration-[#a94c35] decoration-2 underline-offset-4">the official Chile tourism portal / Valparaíso Region</a>.
          </p>
          <a href={place.mapsUrl} target="_blank" rel="noopener noreferrer" class="font-bold text-[#0d2a3a] underline decoration-[#a94c35] decoration-2 underline-offset-4">Open directions in Google Maps ↗</a>
        </div>
      </div>
    </section>

    <section class="mx-auto max-w-5xl px-5 py-20 lg:px-8 lg:py-28" aria-labelledby="faq-title">
      <div class="text-center">
        <p class="port-label mb-3 text-[#a94c35]">08 · FAQ</p>
        <h2 id="faq-title" class="serif-display text-4xl font-bold text-[#0d2a3a] sm:text-5xl">Before you go</h2>
      </div>
      <div class="mt-10 divide-y divide-[#0d2a3a]/15 border-y border-[#0d2a3a]/15">
        {faqEn.map((item) => (
          <details class="group py-5">
            <summary class="flex cursor-pointer list-none items-center justify-between gap-5 rounded-lg py-2 text-lg font-extrabold text-[#0d2a3a]">
              {item.question}
              <span class="text-2xl font-light text-[#a94c35] transition-transform group-open:rotate-45" aria-hidden="true">+</span>
            </summary>
            <p class="max-w-3xl pb-3 pr-10 pt-2 leading-7 text-slate-700">{item.answer}</p>
          </details>
        ))}
      </div>
    </section>

    <SourcesSection lang="en" />
  </main>

  <SiteFooter lang="en" />
</BaseLayout>
