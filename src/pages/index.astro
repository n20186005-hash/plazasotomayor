---
import BaseLayout from '../layouts/BaseLayout.astro';
import Breadcrumbs from '../components/Breadcrumbs.astro';
import SiteFooter from '../components/SiteFooter.astro';
import SourcesSection from '../components/SourcesSection.astro';
import { buildAlternates } from '../i18n';
import { breadcrumb, faq, place } from '../data/place';

const title = 'Plaza Sotomayor, Valparaíso: guía de visita, historia y cómo llegar';
const description = 'Guía de Plaza Sotomayor en Valparaíso, Chile: su historia, el Monumento a los Héroes de Iquique, cómo llegar, mapa y ubicación, qué hacer cerca (Muelle Prat, Ascensor El Peral) y consejos prácticos para tu visita.';
const siteUrl = Astro.site ? new URL('/', Astro.site).toString() : undefined;
const alternates = siteUrl ? buildAlternates(siteUrl, { 'es-cl': '/', en: '/en/' }) : undefined;
const heroImageUrl = Astro.site ? new URL(place.heroImage, Astro.site).toString() : undefined;
const attractionId = siteUrl ? `${siteUrl}#attraction` : undefined;
const webSiteId = siteUrl ? `${siteUrl}#website` : undefined;

const attractionSchema = {
  '@context': 'https://schema.org',
  '@type': ['TouristAttraction', 'LandmarksOrHistoricalBuildings'],
  ...(attractionId ? { '@id': attractionId } : {}),
  name: place.fullName,
  alternateName: place.alternateNames,
  description,
  ...(siteUrl ? { url: siteUrl } : {}),
  ...(heroImageUrl ? { image: [heroImageUrl] } : {}),
  address: {
    '@type': 'PostalAddress',
    streetAddress: 'Plaza Sotomayor',
    addressLocality: place.city,
    addressRegion: place.region,
    postalCode: place.postalCode,
    addressCountry: place.countryCode
  },
  geo: {
    '@type': 'GeoCoordinates',
    latitude: place.latitude,
    longitude: place.longitude
  },
  hasMap: place.mapsUrl,
  containedInPlace: {
    '@type': 'City',
    name: place.city,
    containedInPlace: {
      '@type': 'AdministrativeArea',
      name: place.region,
      containedInPlace: {
        '@type': 'Country',
        name: place.country
      }
    }
  },
  touristType: ['Cultural tourism', 'Heritage tourism', 'City tourism'],
  openingHoursSpecification: [
    {
      '@type': 'OpeningHoursSpecification',
      dayOfWeek: ['Monday', 'Tuesday', 'Wednesday', 'Thursday', 'Friday', 'Saturday', 'Sunday'],
      opens: '00:00',
      closes: '23:59'
    }
  ],
  isAccessibleForFree: true,
  publicAccess: true,
  aggregateRating: {
    '@type': 'AggregateRating',
    ratingValue: place.rating,
    reviewCount: place.reviewCount,
    bestRating: 5,
    worstRating: 1
  },
  sameAs: [place.mapsUrl, place.govtTourismUrl, place.wikipediaUrl, place.municipalityUrl]
};

const webSiteSchema = {
  '@context': 'https://schema.org',
  '@type': 'WebSite',
  ...(webSiteId ? { '@id': webSiteId } : {}),
  ...(siteUrl ? { url: siteUrl } : {}),
  name: 'Plaza Sotomayor — Valparaíso, Chile',
  inLanguage: 'es-CL',
  ...(attractionId ? { about: { '@id': attractionId } } : {})
};

const webPageSchema = {
  '@context': 'https://schema.org',
  '@type': 'WebPage',
  ...(siteUrl ? { '@id': `${siteUrl}#webpage` } : {}),
  ...(siteUrl ? { url: siteUrl } : {}),
  name: title,
  description,
  inLanguage: 'es-CL',
  ...(attractionId ? { about: { '@id': attractionId } } : {}),
  ...(webSiteId ? { isPartOf: { '@id': webSiteId } } : {})
};

const breadcrumbSchema = siteUrl
  ? {
      '@context': 'https://schema.org',
      '@type': 'BreadcrumbList',
      itemListElement: breadcrumb.map((item, index) => ({
        '@type': 'ListItem',
        position: index + 1,
        name: item.name,
        item: item.href === '#inicio' ? siteUrl : `${siteUrl}${item.href}`
      }))
    }
  : undefined;

const faqSchema = {
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  mainEntity: faq.map((item) => ({
    '@type': 'Question',
    name: item.question,
    acceptedAnswer: {
      '@type': 'Answer',
      text: item.answer
    }
  }))
};

const structuredData = [
  attractionSchema,
  webSiteSchema,
  webPageSchema,
  ...(breadcrumbSchema ? [breadcrumbSchema] : []),
  faqSchema
];
---
<BaseLayout
  title={title}
  description={description}
  structuredData={structuredData}
  hreflangAlternates={alternates}
  ogImageAlt="Plaza Sotomayor y el Monumento a los Héroes de Iquique en Valparaíso, Chile"
>
  <header class="absolute inset-x-0 top-0 z-40">
    <div class="mx-auto flex max-w-7xl items-center justify-between px-5 py-5 lg:px-8">
      <a href="#inicio" class="focus-ring inline-flex items-center gap-3 rounded-full bg-[#f4f0e8]/95 px-4 py-2.5 shadow-lg shadow-black/10 backdrop-blur" aria-label="Plaza Sotomayor, volver al inicio">
        <img src="/images/logo.svg" alt="" width="36" height="36" />
        <span class="hidden sm:block">
          <strong class="block text-sm leading-none text-[#0d2a3a]">Plaza Sotomayor</strong>
          <span class="port-label mt-1 block text-[9px] text-[#1f6d79]">Valparaíso · Chile</span>
        </span>
      </a>
      <nav aria-label="Navegación principal" class="flex items-center gap-2">
        <a href="#visita" class="hidden rounded-full bg-white/90 px-4 py-2.5 text-sm font-bold text-[#0d2a3a] backdrop-blur hover:bg-white sm:inline-flex">Planifica</a>
        <a href="#mapa" class="rounded-full bg-[#a94c35] px-4 py-2.5 text-sm font-bold text-white shadow-lg hover:bg-[#923f2d]">Ver mapa</a>
        <a href="/en/" class="hidden rounded-full border border-white/30 bg-white/10 px-4 py-2.5 text-sm font-bold text-white backdrop-blur hover:bg-white/20 sm:inline-flex">English</a>
      </nav>
    </div>
  </header>

  <main>
    <section id="inicio" class="relative min-h-[92svh] overflow-hidden bg-[#0d2a3a] text-white">
      <div class="absolute inset-0">
        <img src={place.photos[0].src} alt={place.photos[0].alt} class="h-full w-full object-cover opacity-55" fetchpriority="high" />
        <div class="absolute inset-0 bg-[linear-gradient(90deg,rgba(5,24,34,.92)_0%,rgba(8,31,43,.64)_47%,rgba(8,31,43,.18)_100%)]"></div>
        <div class="absolute inset-x-0 bottom-0 h-48 bg-gradient-to-t from-[#0d2a3a] to-transparent"></div>
      </div>
      <div class="relative mx-auto flex min-h-[92svh] max-w-7xl items-end px-5 pb-16 pt-36 lg:px-8 lg:pb-24">
        <div class="max-w-4xl">
          <div class="mb-7 flex flex-wrap items-center gap-3 text-sm">
            <span class="port-label rounded-full border border-white/30 bg-white/10 px-3 py-2 backdrop-blur">Centro cívico · Barrio Puerto</span>
            <span class="rounded-full bg-[#f4f0e8] px-3 py-2 font-extrabold text-[#0d2a3a]">★ {place.rating} · {place.reviewCount.toLocaleString('es-CL')} reseñas</span>
          </div>
          <p class="port-label mb-4 text-[#dfc9a5]">Entre el monumento y el mar</p>
          <h1 class="serif-display max-w-4xl text-5xl font-black tracking-[-.04em] sm:text-7xl lg:text-[6.6rem] lg:leading-[.88]">
            Plaza Sotomayor
            <span class="mt-3 block text-2xl font-semibold tracking-normal text-[#dfc9a5] sm:text-3xl">Valparaíso, Chile</span>
          </h1>
          <p class="mt-7 max-w-2xl text-lg leading-8 text-white/82 sm:text-xl">Bienvenido a <strong class="font-extrabold text-white">Plaza Sotomayor</strong>, reconocida internacionalmente como la plaza central de <strong class="font-extrabold text-white">Valparaíso</strong>, Región de Valparaíso, Chile. Es el principal punto de encuentro para quienes visitan la ciudad y su puerto.</p>
          <p class="mt-4 max-w-2xl text-base leading-8 text-white/70 sm:text-lg">El gran salón cívico de Valparaíso: una plaza abierta hacia el puerto, marcada por el Monumento a los Héroes de Iquique y la fachada azul de la antigua Intendencia.</p>
          <div class="mt-9 flex flex-wrap gap-3">
            <a href="#visita" class="rounded-full bg-[#f4f0e8] px-6 py-3.5 font-extrabold text-[#0d2a3a] transition hover:-translate-y-0.5">Preparar la visita</a>
            <a href={place.mapsUrl} target="_blank" rel="noopener noreferrer" class="rounded-full border border-white/35 bg-white/10 px-6 py-3.5 font-extrabold text-white backdrop-blur transition hover:bg-white/20">Abrir en Google Maps ↗</a>
          </div>
        </div>
      </div>
      <div class="absolute bottom-7 right-5 hidden text-right text-xs text-white/70 lg:block lg:right-8">
        <span class="port-label">Coordenadas</span><br />{place.latitude}, {place.longitude}
      </div>
    </section>

    <section id="acerca" class="scroll-mt-24 bg-[#0d2a3a] pb-20 text-white lg:pb-28">
      <div class="mx-auto grid max-w-7xl gap-12 px-5 pt-16 lg:grid-cols-[.85fr_1.15fr] lg:px-8 lg:pt-20">
        <div>
          <Breadcrumbs />
          <p class="port-label mb-4 mt-8 text-[#dfc9a5]">01 · Acerca de la plaza</p>
          <h2 class="serif-display text-4xl font-bold leading-tight sm:text-5xl">Acerca de <span class="text-[#dfc9a5]">Plaza Sotomayor</span></h2>
          <p class="mt-5 text-lg leading-8 text-white/70">Un eje cívico construido con memoria portuaria.</p>
        </div>
        <div class="grid gap-6 text-base leading-8 text-white/76 sm:grid-cols-2">
          <p>Plaza Sotomayor se ubica en la planicie costera de la bahía, frente a Muelle Prat. Fue declarada <strong class="text-white">Zona Típica en 1979</strong> y su área protegida se extendió posteriormente hacia el muelle.</p>
          <p>En el centro se levanta el <strong class="text-white">Monumento a los Héroes de Iquique</strong>, erigido en 1886. Bajo el conjunto se encuentra una cripta vinculada a los marinos de los combates de Iquique y Punta Gruesa.</p>
          <p>El extremo opuesto al mar está presidido por la antigua Intendencia, actual sede naval. El edificio fue proyectado por Ernesto Urquieta y terminado para el centenario de la República.</p>
          <p>La secuencia plaza–estación–muelle muestra en pocos metros la identidad de Valparaíso: administración portuaria, transporte, vida cotidiana, arquitectura monumental y borde marítimo.</p>
        </div>
      </div>

      <div id="historia" class="mx-auto mt-16 max-w-7xl scroll-mt-24 px-5 lg:px-8 lg:mt-20">
        <div class="grid gap-8 lg:grid-cols-[.85fr_1.15fr]">
          <div>
            <p class="port-label mb-4 text-[#dfc9a5]">Historia y significado</p>
            <h2 class="serif-display text-4xl font-bold leading-tight sm:text-5xl">Historia y significado de <span class="text-[#dfc9a5]">Plaza Sotomayor</span></h2>
          </div>
          <div class="grid gap-6 text-base leading-8 text-white/76 sm:grid-cols-2">
            <p>El nombre de la plaza honra a <strong class="text-white">Rafael Sotomayor Baeza</strong>, ministro de Guerra y Marina durante la Guerra del Pacífico. Desde finales del siglo XIX el espacio quedó ligado a la memoria naval del país y a la vida cívica del puerto.</p>
            <p>En <strong class="text-white">1886</strong> se inauguró en su centro el <strong class="text-white">Monumento a los Héroes de Iquique</strong>, que con los años se convirtió en el hito urbano más reconocible de Valparaíso y en punto de ceremonias institucionales.</p>
            <p>El área histórica de Valparaíso fue inscrita en <strong class="text-white">2003</strong> en la Lista del Patrimonio Mundial de la UNESCO. La plaza, el Barrio Puerto y los edificios que la encierran forman parte de ese conjunto portuario protegido.</p>
            <p>Entre el monumento, la antigua Intendencia y el Muelle Prat, la plaza resume la identidad de la ciudad: memoria marítima, arquitectura monumental, transporte y vida cotidiana frente a la bahía.</p>
          </div>
        </div>
        <ol class="mt-12 grid gap-4 sm:grid-cols-2 lg:grid-cols-4">
          <li class="rounded-[1.6rem] border border-white/12 bg-white/[.06] p-6">
            <span class="font-mono text-sm text-[#dfc9a5]">1886</span>
            <p class="mt-4 text-sm leading-6 text-white/72">Inauguración del Monumento a los Héroes de Iquique, obra central de la plaza y de la memoria naval chilena.</p>
          </li>
          <li class="rounded-[1.6rem] border border-white/12 bg-white/[.06] p-6">
            <span class="font-mono text-sm text-[#dfc9a5]">1910</span>
            <p class="mt-4 text-sm leading-6 text-white/72">Se completa el edificio de la antigua Intendencia, proyectado por Ernesto Urquieta, como remate monumental frente al mar.</p>
          </li>
          <li class="rounded-[1.6rem] border border-white/12 bg-white/[.06] p-6">
            <span class="font-mono text-sm text-[#dfc9a5]">1979</span>
            <p class="mt-4 text-sm leading-6 text-white/72">Plaza Sotomayor es declarada Zona Típica junto con los edificios que la encierran, ampliando después su área protegida hacia el muelle.</p>
          </li>
          <li class="rounded-[1.6rem] border border-white/12 bg-white/[.06] p-6">
            <span class="font-mono text-sm text-[#dfc9a5]">2003</span>
            <p class="mt-4 text-sm leading-6 text-white/72">El área histórica portuaria de Valparaíso ingresa a la Lista del Patrimonio Mundial de la UNESCO.</p>
          </li>
        </ol>
      </div>
    </section>

    <section class="mx-auto max-w-7xl px-5 py-20 lg:px-8 lg:py-28" aria-labelledby="galeria-title">
      <div class="mb-10 flex items-end justify-between gap-6">
        <div>
          <p class="port-label mb-3 text-[#a94c35]">02 · Mirar de cerca</p>
          <h2 id="galeria-title" class="serif-display text-4xl font-bold text-[#0d2a3a] sm:text-5xl">Postales del puerto</h2>
        </div>
        <p class="hidden max-w-sm text-sm leading-6 text-slate-600 md:block">Fotografías reales con atribución visible. Los horarios y condiciones del entorno pueden cambiar.</p>
      </div>
      <div class="grid gap-5 md:grid-cols-12">
        <figure class="photo-grain overflow-hidden rounded-[2rem] bg-[#d9c9ad] md:col-span-7">
          <img src={place.photos[1].src} alt={place.photos[1].alt} loading="lazy" class="aspect-[4/3] h-full max-h-[620px] w-full object-cover" />
          <figcaption class="absolute inset-x-0 bottom-0 z-10 bg-gradient-to-t from-black/75 to-transparent p-6 pt-16 text-sm text-white">
            <strong class="block text-base">{place.photos[1].caption}</strong>
            <a href={place.photos[1].source} target="_blank" rel="noopener noreferrer" class="mt-1 inline-block text-white/75 underline decoration-white/30 underline-offset-4">{place.photos[1].author} · {place.photos[1].license}</a>
          </figcaption>
        </figure>
        <div class="grid gap-5 md:col-span-5">
          {place.photos.slice(2).map((photo) => (
            <figure class="photo-grain relative overflow-hidden rounded-[2rem] bg-[#d9c9ad]">
              <img src={photo.src} alt={photo.alt} loading="lazy" class="aspect-[16/10] w-full object-cover" />
              <figcaption class="absolute inset-x-0 bottom-0 z-10 bg-gradient-to-t from-black/80 to-transparent p-5 pt-12 text-xs text-white">
                <strong class="block text-sm">{photo.caption}</strong>
                <a href={photo.source} target="_blank" rel="noopener noreferrer" class="mt-1 inline-block text-white/75 underline decoration-white/30 underline-offset-4">{photo.author} · {photo.license}</a>
              </figcaption>
            </figure>
          ))}
        </div>
      </div>
    </section>

    <section id="visita" class="bg-[#e5dbc8] py-20 lg:py-28">
      <div class="mx-auto max-w-7xl px-5 lg:px-8">
        <div class="grid gap-10 lg:grid-cols-[.75fr_1.25fr]">
          <div>
            <p class="port-label mb-3 text-[#a94c35]">03 · Planifica</p>
            <h2 class="serif-display text-4xl font-bold text-[#0d2a3a] sm:text-5xl">Lo práctico,<br />sin vueltas.</h2>
            <p class="mt-6 max-w-md leading-7 text-slate-700">La plaza funciona mejor como punto de partida. Llega, entiende el eje monumental y después sigue hacia el muelle o sube a los cerros.</p>
          </div>
          <div class="grid gap-4 sm:grid-cols-2">
            <article class="rounded-[1.7rem] bg-[#f7f4ed] p-6 shadow-sm">
              <span class="port-label text-[#1f6d79]">Entrada / costo</span>
              <h3 class="mt-3 text-xl font-extrabold text-[#0d2a3a]">Plaza: gratuita</h3>
              <p class="mt-3 text-sm leading-6 text-slate-700">{place.admission}</p>
            </article>
            <article class="rounded-[1.7rem] bg-[#0d2a3a] p-6 text-white shadow-sm">
              <span class="port-label text-[#dfc9a5]">Horario</span>
              <h3 class="mt-3 text-xl font-extrabold">Acceso continuo</h3>
              <p class="mt-3 text-sm leading-6 text-white/75">Es un espacio público abierto. Museos, comercios y paseos de la bahía manejan sus propios horarios.</p>
            </article>
            <article class="rounded-[1.7rem] bg-[#f7f4ed] p-6 shadow-sm">
              <span class="port-label text-[#1f6d79]">Mejor momento</span>
              <h3 class="mt-3 text-xl font-extrabold text-[#0d2a3a]">Mañana o tarde</h3>
              <p class="mt-3 text-sm leading-6 text-slate-700">{place.bestTime}</p>
            </article>
            <article class="rounded-[1.7rem] bg-[#a94c35] p-6 text-white shadow-sm">
              <span class="port-label text-white/70">Tiempo sugerido</span>
              <h3 class="mt-3 text-xl font-extrabold">45–90 min</h3>
              <p class="mt-3 text-sm leading-6 text-white/80">{place.recommendedStay}</p>
            </article>
          </div>
        </div>
      </div>
    </section>

    <section class="mx-auto max-w-7xl px-5 py-20 lg:px-8 lg:py-28">
      <div class="grid gap-14 lg:grid-cols-2">
        <div>
          <p class="port-label mb-3 text-[#a94c35]">04 · Ubicación y acceso</p>
          <h2 class="serif-display text-4xl font-bold text-[#0d2a3a] sm:text-5xl">Ubicación y cómo visitar Plaza Sotomayor en Valparaíso</h2>
          <p class="mt-5 max-w-md text-lg leading-8 text-slate-700">Llegar al corazón del plan.</p>
          <div class="route-line mt-8 space-y-7">
            <div class="relative pl-8">
              <span class="absolute left-0 top-1.5 h-3 w-3 rounded-full bg-[#a94c35]"></span>
              <h3 class="font-extrabold text-[#0d2a3a]">Metro / tren</h3>
              <p class="mt-1 leading-7 text-slate-700">La Estación Puerto queda en el sector inmediato a Plaza Sotomayor y es una de las llegadas más directas para moverse por el plan de Valparaíso.</p>
            </div>
            <div class="relative pl-8">
              <span class="absolute left-0 top-1.5 h-3 w-3 rounded-full bg-[#a94c35]"></span>
              <h3 class="font-extrabold text-[#0d2a3a]">Bus urbano y trolebús</h3>
              <p class="mt-1 leading-7 text-slate-700">Distintos servicios recorren el plan y el eje del Barrio Puerto. El trolebús forma parte del paisaje de transporte histórico de Valparaíso.</p>
            </div>
            <div class="relative pl-8">
              <span class="absolute left-0 top-1.5 h-3 w-3 rounded-full bg-[#a94c35]"></span>
              <h3 class="font-extrabold text-[#0d2a3a]">Desde el terminal de buses</h3>
              <p class="mt-1 leading-7 text-slate-700">Chile Travel estima aproximadamente 10–15 minutos en taxi o vehículo particular. También puedes combinar transporte urbano o caminar por el plan.</p>
            </div>
            <div class="relative pl-8">
              <span class="absolute left-0 top-1.5 h-3 w-3 rounded-full bg-[#a94c35]"></span>
              <h3 class="font-extrabold text-[#0d2a3a]">Desde Santiago</h3>
              <p class="mt-1 leading-7 text-slate-700">Valparaíso está a unos 120 km por Ruta 68; buses interurbanos, transfer y vehículo particular son las opciones habituales.</p>
            </div>
          </div>
        </div>
        <div class="rounded-[2rem] border border-[#0d2a3a]/10 bg-white p-7 lg:p-9">
          <div class="flex items-start justify-between gap-6">
            <div>
              <p class="port-label text-[#1f6d79]">Estacionamiento</p>
              <h2 class="mt-3 text-3xl font-black text-[#0d2a3a]">Llegar en auto</h2>
            </div>
            <span class="rounded-full bg-[#e5dbc8] px-3 py-1.5 text-xs font-bold text-[#0d2a3a]">Sector Puerto</span>
          </div>
          <p class="mt-6 leading-7 text-slate-700">Hay estacionamientos privados en el entorno de Errázuriz y Estación Puerto, además de oferta en el sector céntrico. Tarifas, acceso y cupos pueden variar; en fines de semana, eventos o ceremonias conviene considerar transporte público.</p>
          <div class="mt-8 border-t border-slate-200 pt-6">
            <h3 class="font-extrabold text-[#0d2a3a]">Consejo porteño</h3>
            <p class="mt-2 text-sm leading-6 text-slate-600">Si tu plan incluye cerros, ascensores y miradores, dejar el auto y continuar a pie suele simplificar el recorrido. Valparaíso tiene pendientes fuertes: calzado cómodo hace una diferencia real.</p>
          </div>
        </div>
      </div>
    </section>

    <section class="bg-[#0d2a3a] py-20 text-white lg:py-28">
      <div class="mx-auto max-w-7xl px-5 lg:px-8">
        <div class="grid gap-12 lg:grid-cols-[.7fr_1.3fr]">
          <div>
            <p class="port-label mb-3 text-[#dfc9a5]">05 · A pie</p>
            <h2 class="serif-display text-4xl font-bold sm:text-5xl">Monumentos y atractivos cerca de Plaza Sotomayor</h2>
            <p class="mt-5 max-w-md leading-7 text-white/70">Al visitar Plaza Sotomayor, los visitantes pueden explorar fácilmente hitos históricos y puntos de interés cercanos, incluidos Muelle Prat y el Ascensor El Peral.</p>
            <p class="mt-3 max-w-md leading-7 text-white/60">No hace falta “terminar” la plaza: úsala como nudo entre el plan, el puerto y los cerros históricos.</p>
          </div>
          <div class="grid gap-4 sm:grid-cols-2">
            {place.nearby.map((item, index) => (
              <article class="rounded-[1.6rem] border border-white/12 bg-white/[.06] p-6">
                <div class="flex items-center justify-between gap-4">
                  <span class="font-mono text-sm text-[#dfc9a5]">0{index + 1}</span>
                  <span class="port-label text-[10px] text-white/45">{item.type}</span>
                </div>
                <h3 class="mt-8 text-2xl font-extrabold">{item.name}</h3>
                <p class="mt-3 text-sm leading-6 text-white/68">{item.detail}</p>
              </article>
            ))}
          </div>
        </div>
      </div>
    </section>

    <section class="mx-auto max-w-7xl px-5 py-20 lg:px-8 lg:py-28">
      <div class="mb-10 grid gap-5 md:grid-cols-2 md:items-end">
        <div>
          <p class="port-label mb-3 text-[#a94c35]">06 · Sabores cerca</p>
          <h2 class="serif-display text-4xl font-bold text-[#0d2a3a] sm:text-5xl">Una pausa en el Barrio Puerto.</h2>
        </div>
        <p class="max-w-lg text-sm leading-6 text-slate-600 md:justify-self-end">Selección orientativa de locales del entorno inmediato. La oferta, carta y horarios pueden cambiar: confirma antes de ir si buscas un servicio específico.</p>
      </div>
      <div class="grid gap-4 md:grid-cols-3">
        {place.food.map((item) => (
          <article class="rounded-[1.7rem] border border-[#0d2a3a]/10 bg-white p-6 shadow-sm">
            <p class="port-label text-[10px] text-[#1f6d79]">{item.kind}</p>
            <h3 class="mt-4 text-2xl font-extrabold text-[#0d2a3a]">{item.name}</h3>
            <p class="mt-1 text-sm font-semibold text-[#a94c35]">{item.address}</p>
            <p class="mt-5 text-sm leading-6 text-slate-600">{item.note}</p>
          </article>
        ))}
      </div>
    </section>

    <section id="mapa" class="scroll-mt-24 bg-[#d9c9ad] py-20 lg:py-28">
      <div class="mx-auto max-w-7xl px-5 lg:px-8">
        <div class="mb-8 flex flex-wrap items-end justify-between gap-5">
          <div>
            <p class="port-label mb-3 text-[#a94c35]">07 · Ubicación y mapa</p>
            <h2 class="serif-display text-4xl font-bold text-[#0d2a3a] sm:text-5xl">Mapa de Plaza Sotomayor: frente a la bahía.</h2>
          </div>
          <div class="text-sm leading-6 text-slate-700 md:text-right">
            <strong>{place.address}</strong><br />Plus Code: {place.plusCode}
          </div>
        </div>
        <div class="overflow-hidden rounded-[2rem] border-8 border-[#f7f4ed] bg-[#f7f4ed] shadow-xl shadow-[#0d2a3a]/10">
          <iframe src={place.embedUrl} title="Mapa de Plaza Sotomayor en Valparaíso" class="h-[480px] w-full border-0 lg:h-[570px]" allowfullscreen loading="lazy" referrerpolicy="strict-origin-when-cross-origin"></iframe>
        </div>
        <div class="mt-5 flex flex-wrap items-center justify-between gap-4">
          <p class="max-w-xl text-sm leading-6 text-slate-700">
            Para información oficial y actualizaciones regionales, visita{' '}
            <a href={place.govtTourismUrl} target="_blank" rel="noopener noreferrer" class="font-bold text-[#0d2a3a] underline decoration-[#a94c35] decoration-2 underline-offset-4">el portal oficial de turismo de Chile / Región de Valparaíso</a>.
          </p>
          <a href={place.mapsUrl} target="_blank" rel="noopener noreferrer" class="font-bold text-[#0d2a3a] underline decoration-[#a94c35] decoration-2 underline-offset-4">Abrir indicaciones en Google Maps ↗</a>
        </div>
      </div>
    </section>

    <section class="mx-auto max-w-5xl px-5 py-20 lg:px-8 lg:py-28" aria-labelledby="faq-title">
      <div class="text-center">
        <p class="port-label mb-3 text-[#a94c35]">08 · FAQ</p>
        <h2 id="faq-title" class="serif-display text-4xl font-bold text-[#0d2a3a] sm:text-5xl">Antes de ir</h2>
      </div>
      <div class="mt-10 divide-y divide-[#0d2a3a]/15 border-y border-[#0d2a3a]/15">
        {faq.map((item) => (
          <details class="group py-5">
            <summary class="flex cursor-pointer list-none items-center justify-between gap-5 rounded-lg py-2 text-lg font-extrabold text-[#0d2a3a]">
              {item.question}
              <span class="text-2xl font-light text-[#a94c35] transition-transform group-open:rotate-45" aria-hidden="true">+</span>
            </summary>
            <p class="max-w-3xl pb-3 pr-10 pt-2 leading-7 text-slate-700">{item.answer}</p>
          </details>
        ))}
      </div>
    </section>

    <SourcesSection />
  </main>

  <SiteFooter lang="es" />
</BaseLayout>
