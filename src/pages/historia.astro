---
import VisitNotice from '../components/VisitNotice.astro';
import PhotoCredits from '../components/PhotoCredits.astro';
import DelsoCredit from '../components/DelsoCredit.astro';
import BaseLayout from '../layouts/BaseLayout.astro';
import SubpageNav from '../components/SubpageNav.astro';
import SiteFooter from '../components/SiteFooter.astro';
import { buildAlternates } from '../i18n';
import { place } from '../data/place';

const siteUrl = Astro.site ? new URL('/', Astro.site).toString() : undefined;
const alternates = siteUrl ? buildAlternates(siteUrl, { 'es-cl': '/historia/', en: '/en/history/' }) : undefined;
const attractionId = siteUrl ? `${siteUrl}#attraction` : undefined;

const title = 'Historia de Plaza Sotomayor: Monumento a los Héroes de Iquique y patrimonio';
const description = 'La historia de Plaza Sotomayor en Valparaíso: el origen del nombre, el Monumento a los Héroes de Iquique, la declaratoria de Zona Típica en 1979 y su inclusión en el Patrimonio Mundial de la UNESCO en 2003.';

const faq = [
  {
    question: '¿Quién fue Rafael Sotomayor y por qué la plaza lleva su nombre?',
    answer: 'Rafael Sotomayor Baeza fue ministro de Guerra y Marina de Chile durante la Guerra del Pacífico. La plaza adoptó su nombre a fines del siglo XIX como homenaje a su gestión y al vínculo de este espacio con la memoria naval del país.'
  },
  {
    question: '¿Qué conmemora el Monumento a los Héroes de Iquique?',
    answer: 'Inaugurado en 1886, el monumento honra a los marinos caídos en los combates navales de Iquique y Punta Gruesa. Bajo el conjunto hay una cripta conmemorativa y el hito se usa para ceremonias cívicas y navales de Valparaíso.'
  },
  {
    question: '¿Por qué Plaza Sotomayor forma parte del Patrimonio Mundial de la UNESCO?',
    answer: 'En 2003 el área histórica portuaria de Valparaíso fue inscrita en la Lista del Patrimonio Mundial. La plaza, el Barrio Puerto y los edificios que la encierran integran ese conjunto patrimonial protegido.'
  },
  {
    question: '¿Por qué Valparaíso es Patrimonio de la Humanidad de la UNESCO?',
    answer: 'En 2003 la UNESCO inscribió el área histórica portuaria de Valparaíso en la Lista del Patrimonio Mundial por su valor urbanístico excepcional: un puerto de ladera con calles, ascensores y arquitectura que reflejan la adaptación de la ciudad al terreno. Plaza Sotomayor y el Barrio Puerto forman parte de ese conjunto protegido frente a la bahía.'
  },
  {
    question: '¿Cuándo se declaró Zona Típica Plaza Sotomayor?',
    answer: 'Plaza Sotomayor fue declarada Zona Típica en 1979, junto con los edificios que la encierran, como la antigua Intendencia. Después su área protegida se extendió hacia el muelle, reforzando la protección de su perfil patrimonial en el plan del puerto.'
  }
];

const attractionSchema = {
  '@context': 'https://schema.org',
  '@type': ['TouristAttraction', 'LandmarksOrHistoricalBuildings'],
  ...(attractionId ? { '@id': attractionId } : {}),
  name: place.fullName,
  url: siteUrl,
  ...(siteUrl ? { image: [new URL(place.heroImage, siteUrl).toString()] } : {})
};

const faqSchema = {
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  mainEntity: faq.map((item) => ({
    '@type': 'Question',
    name: item.question,
    acceptedAnswer: { '@type': 'Answer', text: item.answer }
  }))
};

const breadcrumbSchema = siteUrl
  ? {
      '@context': 'https://schema.org',
      '@type': 'BreadcrumbList',
      itemListElement: [
        { '@type': 'ListItem', position: 1, name: 'Plaza Sotomayor', item: siteUrl },
        { '@type': 'ListItem', position: 2, name: 'Historia', item: `${siteUrl}historia/` }
      ]
    }
  : undefined;

const structuredData = [attractionSchema, faqSchema, ...(breadcrumbSchema ? [breadcrumbSchema] : [])];
---

<BaseLayout lang="es" title={title} description={description} structuredData={structuredData} hreflangAlternates={alternates}>
  <SubpageNav lang="es" altHref="/en/history/" />
  <main>
    <section class="relative overflow-hidden bg-[#0d2a3a] text-white">
      <div class="absolute inset-0">
        <img src={place.photos[1].src} alt={place.photos[1].alt} class="h-full w-full object-cover opacity-50" fetchpriority="high" />
        <div class="absolute inset-0 bg-[linear-gradient(90deg,rgba(5,24,34,.92)_0%,rgba(8,31,43,.7)_60%,rgba(8,31,43,.35)_100%)]"></div>
      </div>
      <div class="relative mx-auto max-w-7xl px-5 pb-16 pt-20 lg:px-8 lg:pb-24 lg:pt-28">
        <p class="port-label mb-4 text-[#dfc9a5]">Historia de la plaza</p>
        <h1 class="serif-display max-w-4xl text-4xl font-black leading-[.95] sm:text-6xl">Historia de Plaza Sotomayor</h1>
        <p class="mt-6 max-w-2xl text-lg leading-8 text-white/80">Desde su origen como plaza portuaria hasta su papel como escenario cívico y patrimonial de Valparaíso, la plaza reúne memoria naval, arquitectura monumental y vida cotidiana frente a la bahía.</p>
      </div>
    <div class="relative mx-auto max-w-7xl px-5 pb-6 lg:px-8"><DelsoCredit lang="es" /></div>
</section>
    <VisitNotice lang="es" />

    <article class="mx-auto max-w-3xl px-5 py-16 lg:px-8 lg:py-24">
      <section class="scroll-mt-24">
        <h2 class="serif-display text-3xl font-bold text-[#0d2a3a] sm:text-4xl">Origen y nombre</h2>
        <p class="mt-5 leading-8 text-slate-700">La plaza se ubica en la planicie costera de la bahía, frente a Muelle Prat, y fue conformándose como el principal espacio cívico del puerto. A fines del siglo XIX adoptó el nombre de <strong class="text-[#0d2a3a]">Rafael Sotomayor Baeza</strong>, ministro de Guerra y Marina durante la Guerra del Pacífico, ligando el lugar a la memoria naval del país.</p>
        <p class="mt-4 leading-8 text-slate-700">El extremo opuesto al mar está presidido por la antigua Intendencia, hoy sede de la Armada de Chile. El edificio, proyectado por Ernesto Urquieta, se completó en 1910 y remata la plaza con su fachada monumental.</p>
      </section>

      <section class="mt-12 scroll-mt-24">
        <h2 class="serif-display text-3xl font-bold text-[#0d2a3a] sm:text-4xl">El Monumento a los Héroes de Iquique</h2>
        <figure class="photo-grain credited-photo mt-6 overflow-hidden rounded-[1.8rem] bg-[#d9c9ad]">
          <img src={place.photos[1].src} alt={place.photos[1].alt} loading="lazy" class="aspect-[4/3] w-full object-cover" />
          <figcaption class="bg-[#0d2a3a] p-4 text-xs text-white/75">{place.photos[1].caption}<DelsoCredit lang="es" /></figcaption>
        </figure>
        <p class="mt-5 leading-8 text-slate-700">En 1886 se inauguró en el centro de la plaza el <strong class="text-[#0d2a3a]">Monumento a los Héroes de Iquique</strong>, erigido para honrar a los marinos caídos en los combates navales de Iquique y Punta Gruesa. Con los años se convirtió en el hito urbano más reconocible de Valparaíso y en punto de ceremonias institucionales. Bajo el conjunto se encuentra una cripta vinculada a esa memoria.</p>
      <p class="mt-4 text-sm leading-7 text-slate-600">Chile Travel coloca “1879” junto al nombre del monumento; el Consejo de Monumentos Nacionales fecha su erección en 1886. Esta guía usa 1886 para el monumento y no toma el paréntesis turístico como fecha de inauguración. <a class="underline" href="https://www.monumentos.gob.cl/monumentos/zonas-tipicas/plaza-sotomayor-de-valparaiso-incluye-los-edificios-que-la-encierran">CMN</a> · <a class="underline" href="https://chile.travel/atractivos/plaza-sotomayor/">Chile Travel</a></p>
</section>

      <section class="mt-12 scroll-mt-24">
        <h2 class="serif-display text-3xl font-bold text-[#0d2a3a] sm:text-4xl">Reconocimiento patrimonial</h2>
        <p class="mt-5 leading-8 text-slate-700">En <strong class="text-[#0d2a3a]">1979</strong> Plaza Sotomayor fue declarada <strong class="text-[#0d2a3a]">Zona Típica</strong> junto con los edificios que la encierran, ampliándose después su área protegida hacia el muelle. En <strong class="text-[#0d2a3a]">2003</strong>, el área histórica portuaria de Valparaíso ingresó a la Lista del Patrimonio Mundial de la UNESCO, y la plaza forma parte de ese conjunto.</p>
        <p class="mt-4 leading-8 text-slate-700">Entre el monumento, la antigua Intendencia y Muelle Prat, la plaza resume la identidad de la ciudad: memoria marítima, arquitectura monumental, transporte y vida cotidiana frente a la bahía.</p>
      </section>

      <section class="mt-12 scroll-mt-24" aria-labelledby="faq-title">
        <h2 id="faq-title" class="serif-display text-3xl font-bold text-[#0d2a3a] sm:text-4xl">Preguntas frecuentes</h2>
        <div class="mt-8 divide-y divide-[#0d2a3a]/15 border-y border-[#0d2a3a]/15">
          {faq.map((item) => (
            <details class="group py-5">
              <summary class="flex cursor-pointer list-none items-center justify-between gap-5 rounded-lg py-2 text-lg font-extrabold text-[#0d2a3a]">
                {item.question}
                <span class="text-2xl font-light text-[#a94c35] transition-transform group-open:rotate-45" aria-hidden="true">+</span>
              </summary>
              <p class="max-w-3xl pb-3 pr-10 pt-2 leading-7 text-slate-700">{item.answer}</p>
            </details>
          ))}
        </div>
      </section>

      <nav aria-label="Páginas relacionadas" class="mt-12 flex flex-wrap gap-3 text-sm">
        <a href="/" class="rounded-full bg-[#0d2a3a] px-4 py-2.5 font-bold text-white hover:bg-[#123347]">← Guía principal de Plaza Sotomayor</a>
        <a href="/como-llegar/" class="rounded-full border border-[#0d2a3a]/15 bg-white px-4 py-2.5 font-bold text-[#0d2a3a] hover:border-[#a94c35]/40">Cómo llegar →</a>
      </nav>
    </article>
  </main>
  <PhotoCredits lang="es" />
  <SiteFooter lang="es" />
</BaseLayout>
