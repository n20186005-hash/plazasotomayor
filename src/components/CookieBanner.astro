---
interface Props {
  lang?: 'es' | 'en';
}
const { lang = 'es' } = Astro.props;
const copy = lang === 'en'
  ? {
      label: 'Cookie preferences',
      title: 'Optional analytics',
      text: 'GA4 is off until you accept on this page. You can withdraw from Analytics. The choice lasts only on this page; navigation or reload asks again.',
      reject: 'Reject',
      accept: 'Accept'
    }
  : {
      label: 'Preferencias de cookies',
      title: 'Analítica opcional',
      text: 'GA4 permanece apagado hasta aceptar en esta página. Puedes retirarlo desde Analítica. La elección solo dura en esta página; al navegar o recargar se vuelve a preguntar.',
      reject: 'Rechazar',
      accept: 'Aceptar'
    };
---

<aside data-cookie-banner class="fixed inset-x-4 bottom-4 z-50 mx-auto max-w-2xl rounded-2xl border border-white/15 bg-[#0d2a3a] p-5 text-white shadow-2xl" role="dialog" aria-label={copy.label}>
  <div class="grid gap-4 sm:grid-cols-[1fr_auto] sm:items-center">
    <div>
      <strong class="text-sm">{copy.title}</strong>
      <p class="mt-1 text-xs leading-5 text-white/65">{copy.text}</p>
    </div>
    <div class="flex gap-2">
      <button type="button" data-cookie-reject class="rounded-full border border-white/25 px-4 py-2 text-xs font-bold hover:bg-white/10">{copy.reject}</button>
      <button type="button" data-cookie-accept class="rounded-full bg-[#d8c29d] px-4 py-2 text-xs font-bold text-[#0d2a3a] hover:bg-[#ead8ba]">{copy.accept}</button>
    </div>
  </div>
</aside>

<button data-cookie-open type="button" class="fixed bottom-3 left-3 z-40 rounded-full bg-[#0d2a3a] px-4 py-2 text-sm text-white shadow" hidden>{lang === 'en' ? 'Analytics' : 'Analítica'}</button>
