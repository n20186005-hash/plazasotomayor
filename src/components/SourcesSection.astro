---
import { imageRightsNotice, place, sources } from '../data/place';
---

<section id="fuentes" class="border-y border-[#0d2a3a]/10 bg-[#f7f4ed] py-16 lg:py-20">
  <div class="mx-auto max-w-7xl px-5 lg:px-8">
    <div class="grid gap-10 lg:grid-cols-[.8fr_1.2fr]">
      <div>
        <p class="port-label mb-3 text-[#1f6d79]">09 · Fuentes y créditos</p>
        <h2 class="serif-display text-4xl font-bold text-[#0d2a3a] sm:text-5xl">Fuentes de orientación y atribución.</h2>
        <p class="mt-4 max-w-md text-sm leading-6 text-slate-600">
          Esta guía contrasta la información con fuentes patrimoniales, turísticas e institucionales. Los datos comerciales, tarifas y horarios de operación pueden cambiar y conviene confirmarlos antes de la visita.
        </p>
        <div class="mt-6 rounded-2xl border border-[#0d2a3a]/10 bg-white p-5">
          <p class="port-label text-[10px] text-[#1f6d79]">Datos del lugar (NAP)</p>
          <address class="mt-3 not-italic text-sm leading-6 text-slate-700">
            <strong class="text-[#0d2a3a]">{place.fullName}</strong><br />
            {place.address}<br />
            {place.region}, {place.country}<br />
            Plus Code: {place.plusCode}
          </address>
          <p class="mt-4 text-xs leading-5 text-slate-500">
            Para información oficial y actualizaciones regionales, visita{' '}
            <a href={place.govtTourismUrl} target="_blank" rel="noopener noreferrer" class="font-bold text-[#a94c35] underline decoration-[#a94c35]/40 underline-offset-2">el portal oficial de turismo de Chile / Región de Valparaíso</a>.
          </p>
        </div>
      </div>
      <div>
        <ol class="grid gap-3">
          {sources.map((source) => (
            <li>
              <a
                href={source.href}
                target="_blank"
                rel="noopener noreferrer"
                class="block rounded-2xl border border-[#0d2a3a]/10 bg-white p-5 transition hover:-translate-y-0.5 hover:border-[#a94c35]/40"
              >
                <span class="font-extrabold text-[#0d2a3a]">{source.label} ↗</span>
                <span class="mt-1 block text-sm leading-6 text-slate-600">{source.note}</span>
              </a>
            </li>
          ))}
        </ol>
        <p class="mt-6 rounded-2xl bg-[#0d2a3a] p-5 text-xs leading-6 text-white/75">
          <strong class="text-white">Derechos de imagen.</strong> {imageRightsNotice}
        </p>
      </div>
    </div>
  </div>
</section>
