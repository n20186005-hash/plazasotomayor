---
import { imageRightsNotice, place, sources } from '../data/place';

interface Props {
  lang?: 'es' | 'en';
}
const { lang = 'es' } = Astro.props;

const copy = lang === 'en'
  ? {
      kicker: '09 · Sources & credits',
      title: 'Orientation sources and attribution.',
      intro: 'This guide cross-checks information with heritage, tourism and institutional sources. Commercial details, fares and opening hours may change, so confirm them before your visit.',
      nap: 'Place and location',
      official: 'For official information and regional updates, visit the official Chile tourism portal / Valparaíso Region.',
      rights: 'Image rights.'
    }
  : {
      kicker: '09 · Fuentes y créditos',
      title: 'Fuentes de orientación y atribución.',
      intro: 'Esta guía contrasta la información con fuentes patrimoniales, turísticas e institucionales. Los datos comerciales, tarifas y horarios de operación pueden cambiar y conviene confirmarlos antes de la visita.',
      nap: 'Lugar y ubicación',
      official: 'el portal oficial de turismo de Chile / Región de Valparaíso',
      rights: 'Derechos de imagen.'
    };
---

<section id="fuentes" class="border-y border-[#0d2a3a]/10 bg-[#f7f4ed] py-16 lg:py-20">
  <div class="mx-auto max-w-7xl px-5 lg:px-8">
    <div class="grid gap-10 lg:grid-cols-[.8fr_1.2fr]">
      <div>
        <p class="port-label mb-3 text-[#1f6d79]">{copy.kicker}</p>
        <h2 class="serif-display text-4xl font-bold text-[#0d2a3a] sm:text-5xl">{copy.title}</h2>
        <p class="mt-4 max-w-md text-sm leading-6 text-slate-600">
          {copy.intro}
        </p>
        <div class="mt-6 rounded-2xl border border-[#0d2a3a]/10 bg-white p-5">
          <p class="port-label text-[10px] text-[#1f6d79]">{copy.nap}</p>
          <address class="mt-3 not-italic text-sm leading-6 text-slate-700">
            <strong class="text-[#0d2a3a]">{place.fullName}</strong><br />
            {place.address}<br />
            {place.region}, {place.country}<br />

          </address>
          <p class="mt-4 text-xs leading-5 text-slate-500">
            {lang === 'en' ? 'Official tourism information: ' : 'Información turística oficial: '}
            <a href={place.govtTourismUrl} target="_blank" rel="noopener noreferrer" class="font-bold text-[#a94c35] underline decoration-[#a94c35]/40 underline-offset-2">{copy.official}</a>.
          </p>
        </div>
      </div>
      <div>
        <ol class="grid gap-3">
          {sources.map((source) => (
            <li>
              <a
                href={source.href}
                target="_blank"
                rel="noopener noreferrer"
                class="block rounded-2xl border border-[#0d2a3a]/10 bg-white p-5 transition hover:-translate-y-0.5 hover:border-[#a94c35]/40"
              >
                <span class="font-extrabold text-[#0d2a3a]">{source.label} ↗</span>
                <span class="mt-1 block text-sm leading-6 text-slate-600">{lang === 'en' ? (source.href.includes('municipalidad') ? 'Municipal construction announcement of 19 October 2026; checked 29 October 2026. Read the dated visit update above.' : source.href.includes('Maps') || source.href.includes('maps.app') ? 'Third-party location and rating snapshot, checked 29 October 2026.' : source.href.includes('commons') ? 'Image source and licence; individual photo credits are provided below.' : 'Heritage or visitor-information source. Check current operating conditions separately.') : source.note}</span>
              </a>
            </li>
          ))}
        </ol>
        <p class="mt-6 rounded-2xl bg-[#0d2a3a] p-5 text-xs leading-6 text-white/75">
          <strong class="text-white">{copy.rights}</strong> {imageRightsNotice}
        </p>
      </div>
    </div>
  </div>
</section>
