---
import { imageRightsNotice, place } from '../data/place';

interface Props {
  lang?: 'es' | 'en';
}
const { lang = 'es' } = Astro.props;

const copy = lang === 'en'
  ? {
      tagline: 'Valparaíso · Región de Valparaíso · Chile',
      blurb: 'An independent guide to know the port heart of Valparaíso.',
      privacy: { summary: 'Privacy', text: 'This site does not request accounts or personal data. Google Analytics 4 loads only if you accept analytics cookies.' },
      cookies: { summary: 'Cookies', text: 'The analytics preference is stored locally in your browser. Rejecting it keeps analytics storage denied.' },
      terms: { summary: 'Terms', text: 'Information is orientative. Confirm prices, hours, access and operating conditions with each provider or authority.' },
      linksTitle: 'Official & heritage links',
      maps: 'Google Maps · Plaza Sotomayor',
      tourism: 'Chile Travel · Valparaíso tourism',
      municipality: 'Municipalidad de Valparaíso',
      wikipedia: 'Wikipedia · Plaza Sotomayor',
      disclaimer: 'Independent informational site; not the official site of Plaza Sotomayor, the Municipalidad de Valparaíso or the Armada de Chile.',
      top: 'Back to top ↑'
    }
  : {
      tagline: 'Valparaíso · Región de Valparaíso · Chile',
      blurb: 'Guía independiente para conocer el corazón portuario de Valparaíso.',
      privacy: { summary: 'Privacidad', text: 'Este sitio no solicita cuentas ni datos personales. Google Analytics 4 se carga únicamente si aceptas cookies analíticas.' },
      cookies: { summary: 'Cookies', text: 'La preferencia de analítica se guarda localmente en tu navegador. Rechazarla mantiene el almacenamiento analítico denegado.' },
      terms: { summary: 'Términos', text: 'La información es orientativa. Confirma precios, horarios, accesos y condiciones operativas con cada proveedor o autoridad correspondiente.' },
      linksTitle: 'Enlaces oficiales y patrimoniales',
      maps: 'Google Maps · Plaza Sotomayor',
      tourism: 'Chile Travel · Turismo de Valparaíso',
      municipality: 'Municipalidad de Valparaíso',
      wikipedia: 'Wikipedia · Plaza Sotomayor',
      disclaimer: 'Sitio informativo independiente; no es el sitio oficial de Plaza Sotomayor, la Municipalidad de Valparaíso ni la Armada de Chile.',
      top: 'Volver arriba ↑'
    };
---

<footer class="bg-[#071c27] px-5 py-12 text-white lg:px-8">
  <div class="mx-auto max-w-7xl">
    <div class="grid gap-10 lg:grid-cols-[1fr_1fr]">
      <div class="flex items-start gap-4">
        <img src="/images/logo-mark-light.svg" alt="" width="56" height="56" />
        <div>
          <strong class="serif-display text-2xl">Plaza Sotomayor</strong>
          <p class="port-label mt-2 text-[10px] text-[#dfc9a5]">{copy.tagline}</p>
          <address class="mt-3 not-italic text-sm leading-6 text-white/60">
            {place.fullName} — {place.address}<br />
            Plus Code: {place.plusCode}
          </address>
          <p class="mt-2 text-sm text-white/55">{copy.blurb}</p>
        </div>
      </div>
      <div class="grid gap-4 text-sm text-white/65 sm:grid-cols-3">
        <details id="privacidad">
          <summary class="cursor-pointer font-bold text-white">{copy.privacy.summary}</summary>
          <p class="mt-3 leading-6">{copy.privacy.text}</p>
        </details>
        <details id="cookies">
          <summary class="cursor-pointer font-bold text-white">{copy.cookies.summary}</summary>
          <p class="mt-3 leading-6">{copy.cookies.text}</p>
        </details>
        <details id="terminos">
          <summary class="cursor-pointer font-bold text-white">{copy.terms.summary}</summary>
          <p class="mt-3 leading-6">{copy.terms.text}</p>
        </details>
      </div>
    </div>
    <nav aria-label={copy.linksTitle} class="mt-9 border-t border-white/10 pt-7">
      <p class="port-label mb-3 text-[10px] text-[#dfc9a5]">{copy.linksTitle}</p>
      <ul class="flex flex-wrap gap-x-5 gap-y-2 text-xs text-white/65">
        <li><a href={place.mapsUrl} target="_blank" rel="noopener noreferrer" class="underline decoration-white/25 underline-offset-2 hover:text-white">{copy.maps}</a></li>
        <li><a href={place.govtTourismUrl} target="_blank" rel="noopener noreferrer" class="underline decoration-white/25 underline-offset-2 hover:text-white">{copy.tourism}</a></li>
        <li><a href={place.municipalityUrl} target="_blank" rel="noopener noreferrer" class="underline decoration-white/25 underline-offset-2 hover:text-white">{copy.municipality}</a></li>
        <li><a href={place.wikipediaUrl} target="_blank" rel="noopener noreferrer" class="underline decoration-white/25 underline-offset-2 hover:text-white">{copy.wikipedia}</a></li>
      </ul>
    </nav>
    <div class="mt-10 flex flex-wrap items-center justify-between gap-5 border-t border-white/10 pt-7 text-xs text-white/45">
      <div>
        <p>{copy.disclaimer}</p>
        <p class="mt-2 max-w-3xl">{imageRightsNotice}</p>
      </div>
      <a href="#top" class="font-bold text-white/70 hover:text-white">{copy.top}</a>
    </div>
  </div>
</footer>
